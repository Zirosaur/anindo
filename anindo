        if not query:
            menu_items = [
                {"action": "search", "title": "🔍 Cari Anime (Semua Koleksi + Lawas)"},
                {"action": "ongoing", "title": "🔥 Anime On-Going Terbaru"},
                {"action": "history", "title": "🕒 Lanjutkan Tontonan Terakhir"}
            ]
            menu_pick = fzf_select(menu_items, prompt="Menu Utama: ", display_fn=lambda x: x["title"])
            if not menu_pick:
                return

            if menu_pick["action"] == "ongoing":
                ongoing_list = get_ongoing_anime()
                selected_anime = fzf_select(ongoing_list, prompt="Pilih Anime Ongoing: ", display_fn=lambda x: x["title"])
            elif menu_pick["action"] == "history":
                hist = load_history()
                if not hist:
                    log_warn("Belum ada riwayat tontonan.")
                    return
                choice = fzf_select(hist, prompt="Lanjutkan Anime: ", display_fn=lambda x: f"{x['anime_title']} ({x['last_ep_title']})")
                if not choice:
                    return
                selected_anime = {
                    "title": choice["anime_title"],
                    "url": choice["anime_url"],
                    "provider": choice.get("provider", "otakudesu")
                }
                target_ep_num = choice["last_ep_num"]
            else:
                try:
                    query = input(f"{C_BOLD}Ketik judul anime: {C_RESET}").strip()
                except (EOFError, KeyboardInterrupt):
                    return
                if not query:
                    return
                results = search_anime(query, provider=args.provider)
                if not results:
                    log_err(f"Anime '{query}' tidak ditemukan di penyedia manapun.")
                    return
                selected_anime = fzf_select(results, prompt="Pilih Anime: ", display_fn=lambda x: x["title"])
        else:
            results = search_anime(query, provider=args.provider)
            if not results:
                log_err(f"Anime '{query}' tidak ditemukan di penyedia manapun.")
                return
            selected_anime = fzf_select(results, prompt="Pilih Anime: ", display_fn=lambda x: x["title"])

    if not selected_anime:
        return

    clean_disp_title = selected_anime.get("raw_title", selected_anime["title"])
    prov_obj = REGISTRY.get(selected_anime.get("provider"))
    prov_display = prov_obj.display_name if prov_obj else "Unknown"
    log_success(f"Memilih: {clean_disp_title} ({prov_display})")

    episodes = get_anime_details(selected_anime)
    if not episodes:
        log_err("Tidak dapat menemukan daftar episode untuk anime ini.")
        return

    # Determine episode index
    cur_ep_idx = 0
    if target_ep_num is not None:
        matched = [(i, ep) for i, ep in enumerate(episodes) if ep["ep_num"] == target_ep_num]
        if matched:
            cur_ep_idx = matched[0][0]
        else:
            log_warn(f"Episode {target_ep_num} tidak ditemukan, silakan pilih manual.")
            selected_ep = fzf_select(episodes, prompt="Pilih Episode: ", display_fn=lambda x: x["title"])
            if not selected_ep:
                return
            cur_ep_idx = episodes.index(selected_ep)
    else:
        selected_ep = fzf_select(episodes, prompt="Pilih Episode: ", display_fn=lambda x: x["title"])
        if not selected_ep:
            return
        cur_ep_idx = episodes.index(selected_ep)

    # Main streaming loop (with auto-next episode and Cross-Provider Fallback!)
    while cur_ep_idx < len(episodes):
        ep = episodes[cur_ep_idx]
        log_info(f"Memproses {ep['title']}...")
        candidates = extract_stream_candidates(ep)

        # Cross-Provider Fallback if no stream candidates found on current provider
        if not candidates:
            log_warn(f"Server tidak ditemukan di {prov_display} untuk {ep['title']}.")
            matched_alt_ep, alt_cands = REGISTRY.find_cross_provider_fallback(clean_disp_title, ep["ep_num"], selected_anime["provider"])
            if alt_cands:
                candidates = alt_cands
                ep = matched_alt_ep or ep
            else:
                log_err(f"Semua penyedia gagal menemukan server untuk {ep['title']}.")
                if cur_ep_idx + 1 < len(episodes):
                    try:
                        c = input("Coba episode selanjutnya? [Y/n]: ").strip().lower()
                        if c in ("", "y", "ya", "yes"):
                            cur_ep_idx += 1
                            continue
                    except (EOFError, KeyboardInterrupt):
                        pass
                break

        # Ranking candidates by score
        def score_candidate(c):
            s = 0
            q = c["quality"]
            if args.quality != "best" and args.quality in q:
                s += 1000
            if "1080" in q: s += 300
            elif "720" in q or "adaptive" in q.lower() or "hd" in q.lower(): s += 200
            elif "480" in q: s += 100
            elif "360" in q: s += 50

            srv = c["server"].lower()
            if "putarin" in srv or "hls" in srv: s += 30
            elif "filedon" in srv: s += 25
            elif "pixeldrain" in srv: s += 20
            elif "yourupload" in srv: s += 18
            elif "odcloud" in srv: s += 15
            else: s += 5
            return s

        candidates.sort(key=score_candidate, reverse=True)

        played_successfully = False
        for cand in candidates:
            s_name = cand["server"]
            s_qual = cand["quality"]
            is_hls = cand.get("is_hls", False)
            log_info(f"Mencoba server {s_name} ({s_qual})...")
            stream_url, ref = cand["resolve_fn"]()
            if not stream_url:
                log_warn(f"Server {s_name} ({s_qual}) tidak tersedia, mencoba alternatif...")
                continue

            save_history(
                selected_anime.get("raw_title", selected_anime["title"]),
                selected_anime["url"],
                ep["title"],
                ep["ep_num"],
                ep["url"],
                selected_anime.get("provider", "otakudesu")
            )

            full_title = f"{clean_disp_title} - {ep['title']}"
            if args.download:
                download_video(stream_url, full_title, s_qual, referer=ref, is_hls=is_hls)
                played_successfully = True
                break
            else:
                ok = play_video(stream_url, full_title, f"{s_qual} - {s_name}", referer=ref, is_hls=is_hls)
                if ok:
                    played_successfully = True
                    break
                else:
                    log_warn(f"Pemutaran video terputus atau gagal di {s_name}, mencoba server lain...")

        # If all candidates on current provider failed to play, attempt Cross-Provider Fallback!
        if not played_successfully:
            log_warn(f"Semua server di {prov_display} gagal memutar {ep['title']}.")
            matched_alt_ep, alt_cands = REGISTRY.find_cross_provider_fallback(clean_disp_title, ep["ep_num"], selected_anime["provider"])
            if alt_cands:
                alt_cands.sort(key=score_candidate, reverse=True)
                for cand in alt_cands:
                    s_name = cand["server"]
                    s_qual = cand["quality"]
                    is_hls = cand.get("is_hls", False)
                    log_info(f"Mencoba server cadangan lintas penyedia: {s_name} ({s_qual})...")
                    stream_url, ref = cand["resolve_fn"]()
                    if stream_url:
                        full_title = f"{clean_disp_title} - {ep['title']} (Fallback)"
                        if args.download:
                            download_video(stream_url, full_title, s_qual, referer=ref, is_hls=is_hls)
                            played_successfully = True
                            break
                        else:
                            ok = play_video(stream_url, full_title, f"{s_qual} - {s_name}", referer=ref, is_hls=is_hls)
                            if ok:
                                played_successfully = True
                                break

        if not played_successfully:
            log_err(f"Semua server alternatif di semua penyedia gagal memuat {ep['title']}.")

        # Next episode prompt
        if cur_ep_idx + 1 < len(episodes):
            next_ep = episodes[cur_ep_idx + 1]
            try:
                print()
                ans = input(f"{C_CYAN}Putar episode berikutnya ({next_ep['title']})? [Y/n]: {C_RESET}").strip().lower()
                if ans in ("", "y", "ya", "yes"):
                    cur_ep_idx += 1
                    continue
                else:
                    break
            except (EOFError, KeyboardInterrupt):
                print()
                break
        else:
            log_success("Ini adalah episode terakhir dari seri ini!")
            break

if __name__ == "__main__":
    main()
