def curl_get(url, referer=None, timeout=12):
    cmd = ["curl", "-s", "-L", "--max-time", str(timeout), "-H", f"User-Agent: {USER_AGENT}"]
    if referer:
        cmd.extend(["-H", f"Referer: {referer}"])
    cmd.append(url)
    try:
        return subprocess.check_output(cmd).decode("utf-8", "ignore")
    except Exception:
        return ""

def curl_redirect(url, timeout=5):
    cmd = ["curl", "-s", "-I", "--max-time", str(timeout), "-H", f"User-Agent: {USER_AGENT}", url]
    try:
        out = subprocess.check_output(cmd).decode("utf-8", "ignore")
        m = re.search(r"[Ll]ocation:\s*([^\r\n]+)", out)
        return m.group(1).strip() if m else None
    except Exception:
        return None

def curl_post_ajax(body_dict, referer, timeout=6):
    otakudesu_base = get_base_url("otakudesu")
    rules = get_rules()
    ajax_ep = rules.get("otakudesu", {}).get("ajax_endpoint", "/wp-admin/admin-ajax.php")
    body_str = "&".join(f"{k}={v}" for k, v in body_dict.items())
    cmd = [
        "curl", "-s", "-X", "POST", f"{otakudesu_base}{ajax_ep}",
        "-H", f"User-Agent: {USER_AGENT}",
        "-H", f"Referer: {referer}",
        "-H", f"Origin: {otakudesu_base}",
        "-H", "X-Requested-With: XMLHttpRequest",
        "--max-time", str(timeout),
        "-d", body_str
    ]
    try:
        out = subprocess.check_output(cmd).decode("utf-8", "ignore")
        return json.loads(out)
    except Exception:
        return {}

def resolve_pixeldrain(raw_href):
    loc = curl_redirect(raw_href, timeout=5)
    if not loc or "pixeldrain.com/u/" not in loc:
        return None, None
    file_id = loc.split("/u/")[1].split("/")[0]
    p_url = f"https://pixeldrain.com/api/file/{file_id}"
    
    cmd = ["curl", "-s", "-I", "--max-time", "3", p_url]
    try:
        out = subprocess.check_output(cmd).decode("utf-8", "ignore")
        first_line = out.splitlines()[0] if out.splitlines() else ""
        if "200" in first_line:
            return p_url, None
        elif "451" in first_line:
            log_warn("Pixeldrain: Berkas diblokir DMCA (HTTP 451)")
        elif "404" in first_line:
            log_warn("Pixeldrain: Berkas tidak ditemukan (HTTP 404)")
        else:
            log_warn(f"Pixeldrain tidak merespon 200 OK: {first_line.strip()}")
    except Exception:
        pass
    return None, None

def resolve_filedon(raw_href):
    loc = curl_redirect(raw_href, timeout=5) if "desustream" in raw_href else raw_href
    if not loc:
        return None, None
    embed_url = loc.replace("/view/", "/embed/")
    try:
        page = curl_get(embed_url, timeout=5)
        m = re.search(r'data-page="([^"]+)"', page)
        if m:
            data = json.loads(html.unescape(m.group(1)))
            r2_url = data.get("props", {}).get("url")
            if r2_url:
                return r2_url, None
    except Exception:
        pass
    return None, None

def resolve_yourupload_embed(embed_url):
    m_id = re.search(r'id=([A-Za-z0-9_-]+)', embed_url) or re.search(r'/embed/([A-Za-z0-9_-]+)', embed_url)
    if not m_id:
        return None, None
    yu_id = m_id.group(1)
    page = curl_get(f"https://yourupload.com/embed/{yu_id}", referer="https://desudrive.com/", timeout=6)
    v_match = re.search(r"file\s*:\s*['\"](https?://[^'\"]+\.mp4[^'\"]*)['\"]", page) or re.search(r'property="og:video"\s+content="([^"]+)"', page)
    if v_match:
        return v_match.group(1), "https://yourupload.com/"
    return None, None

def resolve_mirror_stream(ep_url, data_b64, mirror_name, actions):
    if len(actions) < 2:
        return None, None
    nonce_data = curl_post_ajax({"action": actions[1]}, referer=ep_url)
    nonce = nonce_data.get("data")
    if not nonce:
        return None, None

    payload = json.loads(base64.b64decode(data_b64).decode("utf-8"))
    payload["nonce"] = nonce
    payload["action"] = actions[0]

    resp = curl_post_ajax(payload, referer=ep_url)
    embed_b64 = resp.get("data", "")
    if not embed_b64:
        return None, None
    embed_html = base64.b64decode(embed_b64).decode("utf-8", "ignore")
    src_m = re.search(r'src=["\']([^"\']+)["\']', embed_html)
    if not src_m:
        return None, None
    src_url = src_m.group(1)

    if "yourupload" in mirror_name.lower() or "yuplod" in src_url:
        return resolve_yourupload_embed(src_url)
    elif "filedon" in mirror_name.lower() or "filedon" in src_url:
        return resolve_filedon(src_url)
    
    return src_url, None

def resolve_putarin(embed_url):
    """Decrypt Putarin/Puterin player config to obtain HLS m3u8 stream URL."""
    if AESGCM is None:
        log_err("Modul 'cryptography' belum terpasang. Jalankan: pip install cryptography")
        return None, None

    domain = urllib.parse.urlparse(embed_url).netloc
    page_html = curl_get(embed_url, referer=f"https://{domain}/", timeout=8)
    m = re.search(r'window\.__PX\s*=\s*(\{.*?\});', page_html)
    if not m:
        return None, None

    try:
        px = json.loads(m.group(1))
        n_val = px.get("n", "")
        d_b64 = px.get("d", "")

        pk_url = f"https://{domain}/api/pk?n={urllib.parse.quote(n_val)}"
        k_hex = curl_get(pk_url, referer=embed_url, timeout=6).strip()
        if not k_hex or len(k_hex) < 64:
            return None, None

        key = bytes.fromhex(k_hex)
        raw_d = base64.b64decode(d_b64)
        iv = raw_d[:12]
        ct = raw_d[12:]

        aes = AESGCM(key)
        pt = aes.decrypt(iv, ct, None)
        cfg = json.loads(pt.decode("utf-8"))
        file_path = cfg.get("file", "")
        if not file_path:
            return None, None

        if file_path.startswith("/"):
            file_path = f"https://{domain}" + file_path
        return file_path, f"https://{domain}/"
    except Exception as e:
        log_warn(f"Gagal mendekripsi stream Putarin: {e}")
        return None, None

def fix_m3u8_content(content_str, base_url):
    """Normalize protocol-relative and relative URLs in m3u8 playlists for local playback."""
    parsed = urllib.parse.urlparse(base_url)
    base_scheme = parsed.scheme or "https"
    base_netloc = parsed.netloc

    out_lines = []
    for line in content_str.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith("#"):
            def repl_uri(m):
                u = m.group(1)
                if u.startswith("//"):
                    return f'URI="{base_scheme}:{u}"'
                elif u.startswith("/"):
                    return f'URI="{base_scheme}://{base_netloc}{u}"'
                return m.group(0)
            out_lines.append(re.sub(r'URI="([^"]+)"', repl_uri, line))
        else:
            if stripped.startswith("//"):
                out_lines.append(f"{base_scheme}:{stripped}")
            elif stripped.startswith("/"):
                out_lines.append(f"{base_scheme}://{base_netloc}{stripped}")
            elif not (stripped.startswith("http://") or stripped.startswith("https://")):
                base_dir = base_url.rsplit("/", 1)[0]
                out_lines.append(f"{base_dir}/{stripped}")
            else:
                out_lines.append(stripped)
    return "\n".join(out_lines).encode("utf-8")

