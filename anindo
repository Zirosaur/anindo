    def get_episodes(self, anime_url: str) -> list[dict]:
        html_page = curl_get(anime_url)
        rules = get_rules()
        anchor = rules.get(self.name, {}).get("episode_anchor", "/episode/")

        parser = DOMParser()
        parser.feed(html_page)

        episodes = []
        seen = set()
        for l in parser.links:
            href = l["href"]
            if anchor in href and href not in seen:
                seen.add(href)
                text = l["text"] or l["title"]
                clean_title = text.replace("&#8211;", "-").replace("&amp;", "&").replace("Subtitle Indonesia", "").strip()
                num_m = re.search(r'Episode\s*(\d+(?:\.\d+)?)', clean_title, re.IGNORECASE)
                ep_num = float(num_m.group(1)) if num_m else 0
                episodes.append({
                    "title": clean_title,
                    "url": href,
                    "ep_num": ep_num,
                    "provider": self.name
                })

        episodes.sort(key=lambda x: x["ep_num"] if x["ep_num"] > 0 else 9999)
        return episodes

    def extract_streams(self, ep_url: str) -> list[dict]:
        html_page = curl_get(ep_url)
        candidates = []

        # 1. Direct odcloud / desustream
        iframes = re.findall(r'<iframe[^>]+src="([^"]+)"', html_page)
        for ifr in iframes:
            if "desustream" in ifr or "odcdn" in ifr:
                try:
                    ifr_html = curl_get(ifr, referer=ep_url, timeout=4)
                    v_urls = re.findall(r'videoURL\s*=\s*["\']([^"\']+)["\']', ifr_html)
                    for v in v_urls:
                        candidates.append({
                            "quality": "720p",
                            "server": "ODCloud",
                            "is_hls": False,
                            "resolve_fn": lambda v_url=v: (v_url, None)
                        })
                except Exception:
                    pass

        # 2. Download section mirrors (Filedon, Pixeldrain)
        m = re.search(r'<div class="download">(.*?)</div>', html_page, re.DOTALL)
        if m:
            for li in re.findall(r'<li>(.*?)</li>', m.group(1), re.DOTALL):
                q_m = re.search(r'<strong>(.*?)</strong>', li)
                quality = q_m.group(1).strip() if q_m else "720p"
                links = re.findall(r'<a href="([^"]+)"[^>]*>([^<]+)</a>', li)
                for href, host in links:
                    host_clean = host.strip()
                    if host_clean in ["Filedon"]:
                        candidates.append({
                            "quality": quality,
                            "server": "Filedon",
                            "is_hls": False,
                            "resolve_fn": lambda h=href: resolve_filedon(h)
                        })
                    elif host_clean in ["Pdrain", "Pixeldrain", "PDrain"]:
                        candidates.append({
                            "quality": quality,
                            "server": "Pixeldrain",
                            "is_hls": False,
                            "resolve_fn": lambda h=href: resolve_pixeldrain(h)
                        })

        # 3. Mirrorstream section (YourUpload, Filedon, VidHide, etc.)
        actions = re.findall(r'action:"([a-f0-9]{32})"', html_page)
        mirrors = re.findall(r'<a\s+href="#"\s+data-content="([^"]+)">([^<]+)</a>', html_page)
        for b64, name in mirrors:
            try:
                payload = json.loads(base64.b64decode(b64).decode("utf-8"))
                quality = payload.get("q", "720p")
                clean_name = name.strip()
                if any(k in clean_name.lower() for k in ["yourupload", "filedon", "vidhide", "odstream", "ondesuhd"]):
                    candidates.append({
                        "quality": quality,
                        "server": f"{clean_name.title()} (Mirror)",
                        "is_hls": False,
                        "resolve_fn": lambda b=b64, n=clean_name: resolve_mirror_stream(ep_url, b, n, actions)
                    })
            except Exception:
                pass

        return candidates

class NontonAnimeProvider(BaseProvider):
    """Provider implementation for NontonAnime (Classic 90s-2000s Anime & Vintage Archive)."""
    name = "nontonanime"
    display_name = "NontonAnime"

    def search(self, query: str) -> list[dict]:
        base = get_base_url(self.name)
        rules = get_rules()
        search_path = rules.get(self.name, {}).get("search_path", "/?s={query}").format(query=urllib.parse.quote(query))
        html_page = curl_get(f"{base}{search_path}")

        parser = DOMParser()
        parser.feed(html_page)

        results = []
        seen = set()
        anime_anchor = rules.get(self.name, {}).get("anime_anchor", "/anime/")

        for l in parser.links:
            href = l["href"]
            if anime_anchor in href and href not in seen:
                raw_title = l["text"] or l["title"] or "Unknown"
                if len(raw_title) > 2:
                    seen.add(href)
                    clean = re.sub(r'[\r\n\t]+', ' ', raw_title).strip()
                    results.append({
                        "title": f"{clean} [{self.display_name}]",
                        "raw_title": clean,
                        "url": href,
                        "provider": self.name
                    })

        return results

    def get_episodes(self, anime_url: str) -> list[dict]:
        html_page = curl_get(anime_url)
        rules = get_rules()
        anchor = rules.get(self.name, {}).get("episode_anchor", "/nonton/")

        parser = DOMParser()
        parser.feed(html_page)

        episodes = {}
        for l in parser.links:
            href = l["href"]
            if anchor in href:
                m = re.search(r'episode-(\d+(?:\.\d+)?)', href)
                if m:
                    ep_num = float(m.group(1))
                    if ep_num not in episodes:
                        clean_title = f"Episode {int(ep_num) if ep_num.is_integer() else ep_num}"
                        episodes[ep_num] = {
                            "title": clean_title,
                            "url": href,
                            "ep_num": ep_num,
                            "provider": self.name
                        }

        sorted_eps = [episodes[k] for k in sorted(episodes.keys())]
        return sorted_eps

    def extract_streams(self, ep_url: str) -> list[dict]:
        html_page = curl_get(ep_url)
        candidates = []

        parser = DOMParser()
        parser.feed(html_page)

        for ifr in parser.iframes:
            if "putarin" in ifr or "puterin" in ifr:
                domain = urllib.parse.urlparse(ifr).netloc
                candidates.append({
                    "quality": "Adaptive HD",
                    "server": f"Putarin ({domain})",
                    "is_hls": True,
                    "resolve_fn": lambda u=ifr: resolve_putarin(u)
                })

        return candidates

class ProviderRegistry:
    """Registry that manages modular anime providers and provides concurrent multi-provider search."""
    def __init__(self):
        self._providers: dict[str, BaseProvider] = {}

    def register(self, provider: BaseProvider):
        self._providers[provider.name] = provider

    def get(self, name: str) -> BaseProvider | None:
        return self._providers.get(name)

    def all(self) -> list[BaseProvider]:
        return list(self._providers.values())

    def names(self) -> list[str]:
        return list(self._providers.keys())

    def search_all(self, query: str, active_provider: str = "all") -> list[dict]:
        log_info(f"Mencari '{query}'...")
        if active_provider in self._providers:
            return self._providers[active_provider].search(query)

        results = []
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(self._providers)) as executor:
            futures = {executor.submit(p.search, query): p for p in self._providers.values()}
            for f in concurrent.futures.as_completed(futures):
                try:
                    res = f.result()
                    if res:
                        results.extend(res)
                except Exception:
                    pass
        return results

    def find_cross_provider_fallback(self, anime_raw_title: str, ep_num: float, exclude_provider: str) -> tuple[dict | None, list[dict]]:
        """
        Cross-Provider Episode Stream Fallback:
        Searches other providers for the same anime title & episode number if the current provider fails!
        """
        log_warn(f"Mencari cadangan lintas penyedia (Cross-Provider Fallback)...")
        for p_name, provider in self._providers.items():
            if p_name == exclude_provider:
                continue
            try:
                matches = provider.search(anime_raw_title)
                if not matches:
                    continue
                # Pick the best match
                alt_anime = matches[0]
                eps = provider.get_episodes(alt_anime["url"])
                matched_ep = next((e for e in eps if e["ep_num"] == ep_num), None)
                if matched_ep:
                    cands = provider.extract_streams(matched_ep["url"])
                    if cands:
                        log_success(f"Menemukan mirror cadangan di {provider.display_name} untuk Episode {ep_num}!")
                        return matched_ep, cands
            except Exception:
                pass
        return None, []

