def save_history(anime_title, anime_url, episode_title, episode_num, episode_url, provider,
                 status="in_progress", time_pos=0, percent=0, duration=0):
    history = {}
    if HISTORY_FILE.exists():
        try:
            with open(HISTORY_FILE, "r") as f:
                history = json.load(f)
        except Exception:
            history = {}

    existing = history.get(anime_url)
    if existing and existing.get("last_ep_num") == episode_num:
        if status == "not_started" and time_pos == 0 and existing.get("time_pos", 0) > 0:
            time_pos = existing["time_pos"]
            percent = existing.get("percent", 0)
            duration = existing.get("duration", duration)
            status = existing.get("status", "in_progress")

    now_ts = int(time.time())
    now_str = time.strftime("%Y-%m-%d %H:%M", time.localtime(now_ts))
    history[anime_url] = {
        "anime_title": anime_title,
        "anime_url": anime_url,
        "last_ep_title": episode_title,
        "last_ep_num": episode_num,
        "last_ep_url": episode_url,
        "provider": provider,
        "timestamp": now_ts,
        "date_str": now_str,
        "status": status,
        "time_pos": time_pos,
        "percent": percent,
        "duration": duration
    }

    try:
        with open(HISTORY_FILE, "w") as f:
            json.dump(history, f, indent=2)
    except Exception:
        pass

def load_history():
    if not HISTORY_FILE.exists():
        return []
    try:
        with open(HISTORY_FILE, "r") as f:
            data = json.load(f)
            items = list(data.values())
            items.sort(key=lambda x: x.get("timestamp", 0), reverse=True)
            return items
    except Exception:
        return []

