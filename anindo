        if not selected_ep:
            return
        cur_ep_idx = episodes.index(selected_ep)

    # Main streaming loop (supports auto-next episode and mirror fallback)
    while cur_ep_idx < len(episodes):
        ep = episodes[cur_ep_idx]
        log_info(f"Memproses {ep['title']}...")
        candidates = extract_stream_candidates(ep)
        if not candidates:
            log_err(f"Tidak ada server video yang ditemukan untuk {ep['title']}.")
            if cur_ep_idx + 1 < len(episodes):
                try:
                    c = input("Coba episode selanjutnya? [Y/n]: ").strip().lower()
                    if c in ("", "y", "ya", "yes"):
                        cur_ep_idx += 1
                        continue
                except (EOFError, KeyboardInterrupt):
                    pass
            break

        # Ranking function based on user quality preference and server reliability
        def score_candidate(c):
            s = 0
            q = c["quality"]
            if args.quality != "best":
                if args.quality in q:
                    s += 1000
            if "1080" in q: s += 300
            elif "720" in q or "adaptive" in q.lower() or "hd" in q.lower(): s += 200
            elif "480" in q: s += 100
            elif "360" in q: s += 50

            srv = c["server"].lower()
            if "putarin" in srv or "hls" in srv: s += 30
            elif "filedon" in srv: s += 25
            elif "pixeldrain" in srv: s += 20
            elif "yourupload" in srv: s += 18
            elif "odcloud" in srv: s += 15
            else: s += 5
            return s

        candidates.sort(key=score_candidate, reverse=True)

        played_successfully = False
        for cand in candidates:
            s_name = cand["server"]
            s_qual = cand["quality"]
            is_hls = cand.get("is_hls", False)
            log_info(f"Mencoba server {s_name} ({s_qual})...")
            stream_url, ref = cand["resolve_fn"]()
            if not stream_url:
                log_warn(f"Server {s_name} ({s_qual}) tidak tersedia, mencoba alternatif berikutnya...")
                continue

            save_history(
                selected_anime.get("raw_title", selected_anime["title"]),
                selected_anime["url"],
                ep["title"],
                ep["ep_num"],
                ep["url"],
                selected_anime.get("provider", "otakudesu")
            )

            full_title = f"{clean_disp_title} - {ep['title']}"
            if args.download:
                download_video(stream_url, full_title, s_qual, referer=ref, is_hls=is_hls)
                played_successfully = True
                break
            else:
                ok = play_video(stream_url, full_title, f"{s_qual} - {s_name}", referer=ref, is_hls=is_hls)
                if ok:
                    played_successfully = True
                    break
                else:
                    log_warn(f"Pemutaran video terputus atau gagal di {s_name}, mencoba server lain...")

        if not played_successfully:
            log_err(f"Semua server alternatif untuk {ep['title']} gagal dimuat.")

        # Next episode prompt
        if cur_ep_idx + 1 < len(episodes):
            next_ep = episodes[cur_ep_idx + 1]
            try:
                print()
                ans = input(f"{C_CYAN}Putar episode berikutnya ({next_ep['title']})? [Y/n]: {C_RESET}").strip().lower()
                if ans in ("", "y", "ya", "yes"):
                    cur_ep_idx += 1
                    continue
                else:
                    break
            except (EOFError, KeyboardInterrupt):
                print()
                break
        else:
            log_success("Ini adalah episode terakhir dari seri ini!")
            break

