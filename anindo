def format_time(seconds):
    """Format seconds into HH:MM:SS or MM:SS."""
    if not seconds or seconds < 0:
        return "00:00"
    s = int(seconds)
    m, s = divmod(s, 60)
    h, m = divmod(m, 60)
    if h > 0:
        return f"{h:02d}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"

def play_video(url, title, quality_label="", referer=None, is_hls=False, start_pos=0):
    """Play video stream with MPV and real-time playback state tracking."""
    server = None
    stream_to_play = url

    if is_hls:
        try:
            raw_m3u8 = curl_get(url, referer=referer, timeout=10)
            if not raw_m3u8:
                log_warn("Gagal mengunduh daftar putar m3u8.")
                return False, {"status": "error", "time_pos": 0, "percent": 0, "duration": 0}
            fixed_bytes = fix_m3u8_content(raw_m3u8, url)

            class LocalM3U8Handler(BaseHTTPRequestHandler):
                def do_GET(self):
                    self.send_response(200)
                    self.send_header("Content-Type", "application/vnd.apple.mpegurl")
                    self.send_header("Content-Length", str(len(fixed_bytes)))
                    self.send_header("Access-Control-Allow-Origin", "*")
                    self.end_headers()
                    self.wfile.write(fixed_bytes)
                def log_message(self, format, *args):
                    pass

            server = HTTPServer(("127.0.0.1", 0), LocalM3U8Handler)
            port = server.server_address[1]
            threading.Thread(target=server.serve_forever, daemon=True).start()
            stream_to_play = f"http://127.0.0.1:{port}/stream.m3u8"
        except Exception as e:
            log_warn(f"Gagal menyiapkan pemutar HLS lokal: {e}")
            return False, {"status": "error", "time_pos": 0, "percent": 0, "duration": 0}

    # Desktop notification asynchronously
    def send_notification():
        if not USER_CONFIG.get("notify", True):
            return
        try:
            subprocess.run(
                ["notify-send", "-a", "anindo", "-i", "video-player", "anindo - Memutar Anime", title],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2
            )
        except Exception:
            pass
    threading.Thread(target=send_notification, daemon=True).start()

    sock_path = f"/tmp/anindo-mpv-{os.getpid()}.sock"
    static_sock = "/tmp/anindo-mpv.sock"

    for p in (sock_path, static_sock):
        if os.path.islink(p) or os.path.exists(p):
            try:
                os.unlink(p)
            except Exception:
                pass

    try:
        os.symlink(sock_path, static_sock)
    except Exception:
        pass

    # Render modern, elegant terminal player dashboard
    if sys.stdout.isatty():
        render_player_dashboard(title, quality_label)

    # Temporary input.conf for in-player hotkeys & on-screen OSD cheat-sheet
    input_conf_file = Path(f"/tmp/anindo-input-{os.getpid()}.conf")
    help_osd = (
        "══ PANDUAN KONTROL ANINDO ══\\n"
        "[Spasi]   : Jeda / Putar (Play/Pause)\\n"
        "[N] / [>] : Episode Berikutnya\\n"
        "[P] / [<] : Episode Sebelumnya\\n"
        "[←] / [→] : Mundur / Maju 5s\\n"
        "[↓] / [↑] : Mundur / Maju 60s\\n"
        "[9] / [0] : Volume - / + (2%)\\n"
        "[M]       : Bisukan Suara (Mute/Unmute)\\n"
        "[F]       : Layar Penuh (Fullscreen)\\n"
        "[S]       : Tangkapan Layar (Screenshot)\\n"
        "[Q]       : Keluar ke Menu Navigasi"
    )
    try:
        with open(input_conf_file, "w", encoding="utf-8") as f:
            f.write(
                f"n quit 2\n"
                f"N quit 2\n"
                f"> quit 2\n"
                f"p quit 3\n"
                f"P quit 3\n"
                f"< quit 3\n"
                f"? show-text \"{help_osd}\" 7000\n"
                f"h show-text \"{help_osd}\" 7000\n"
                f"H show-text \"{help_osd}\" 7000\n"
                f"F1 show-text \"{help_osd}\" 7000\n"
            )
    except Exception:
        input_conf_file = None

    mpv_cmd = [
        "mpv",
        f"--title=anindo: {title}",
        f"--force-media-title=[Sub Indo] {title}",
        f"--user-agent={USER_AGENT}",
        "--resume-playback=yes",
        "--save-position-on-quit=yes",
        "--keep-open=no",
        f"--input-ipc-server={sock_path}",
    ]
    if input_conf_file:
        mpv_cmd.append(f"--input-conf={input_conf_file}")

    clean_osd_title = re.sub(r'[\r\n]+', ' ', title)
    mpv_cmd.append(f"--osd-playing-msg=[anindo] {clean_osd_title}\\n[N] Next  |  [P] Prev  |  [Spasi] Pause  |  [?] Bantuan Keyboard  |  [Q] Menu")
    mpv_cmd.append("--osd-playing-msg-duration=5000")

    # Append custom user flags from ~/.config/anindo/config.json
    user_flags = USER_CONFIG.get("mpv_flags", [])
    if isinstance(user_flags, str):
        user_flags = shlex.split(user_flags)
    if isinstance(user_flags, list):
        for flag in user_flags:
            if flag and isinstance(flag, str):
                mpv_cmd.append(flag)

    if start_pos and start_pos > 5:
        mpv_cmd.append(f"--start={int(start_pos)}")
        log_info(f"Melanjutkan dari menit {format_time(start_pos)}...")

    if referer:
        mpv_cmd.append(f"--referrer={referer}")

    mpv_cmd.append(stream_to_play)

    playback_state = {"time_pos": 0.0, "percent": 0.0, "duration": 0.0, "pause": False}
    stop_event = threading.Event()

    def monitor_ipc():
        s = None
        for _ in range(40):
            if os.path.exists(sock_path):
                try:
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.settimeout(0.5)
                    s.connect(sock_path)
                    break
                except Exception:
                    time.sleep(0.05)
            time.sleep(0.05)
        if not s:
            return

        last_rendered = None
        while not stop_event.is_set():
            try:
                # Query percent-pos
                s.sendall(b'{"command": ["get_property", "percent-pos"]}\n')
                res = s.recv(1024).decode("utf-8", "ignore")
                for line in res.strip().split("\n"):
                    if line:
                        try:
                            d = json.loads(line)
                            if isinstance(d.get("data"), (int, float)):
                                playback_state["percent"] = d["data"]
                        except Exception:
                            pass

                # Query time-pos
                s.sendall(b'{"command": ["get_property", "time-pos"]}\n')
                res = s.recv(1024).decode("utf-8", "ignore")
                for line in res.strip().split("\n"):
                    if line:
                        try:
                            d = json.loads(line)
                            if isinstance(d.get("data"), (int, float)):
                                playback_state["time_pos"] = d["data"]
                        except Exception:
                            pass

                # Query duration
                s.sendall(b'{"command": ["get_property", "duration"]}\n')
                res = s.recv(1024).decode("utf-8", "ignore")
                for line in res.strip().split("\n"):
                    if line:
                        try:
                            d = json.loads(line)
                            if isinstance(d.get("data"), (int, float)):
                                playback_state["duration"] = d["data"]
                        except Exception:
                            pass

                # Query pause state
                s.sendall(b'{"command": ["get_property", "pause"]}\n')
                res = s.recv(1024).decode("utf-8", "ignore")
                for line in res.strip().split("\n"):
                    if line:
                        try:
                            d = json.loads(line)
                            if isinstance(d.get("data"), bool):
                                playback_state["pause"] = d["data"]
                        except Exception:
                            pass

                # Render dynamic progress line cleanly on a single line
                if sys.stdout.isatty():
                    cur_t = playback_state.get("time_pos", 0.0)
                    dur_t = playback_state.get("duration", 0.0)
                    pct = playback_state.get("percent", 0.0)
                    is_paused = playback_state.get("pause", False)

                    status_tag = f"{C_YELLOW}⏸ JEDA {C_RESET}" if is_paused else f"{C_GREEN}▶ PUTAR{C_RESET}"
                    cur_s = format_time(cur_t)
                    dur_s = format_time(dur_t) if dur_t > 0 else "--:--"

                    bar_len = 16
                    filled = min(bar_len, max(0, int(round((pct / 100.0) * bar_len))))
                    bar = "━" * filled + ("╸" if filled < bar_len else "") + "─" * max(0, bar_len - 1 - filled)

                    progress_line = f"  {status_tag} [{cur_s} / {dur_s}] ❲{bar}❳ {pct:5.1f}%"
                    cols = shutil.get_terminal_size((80, 24)).columns
                    if str_display_width(progress_line) >= cols:
                        progress_line = f"  {status_tag} [{cur_s}/{dur_s}] {pct:4.0f}%"

                    rendered_key = (cur_s, is_paused)
                    if rendered_key != last_rendered:
                        last_rendered = rendered_key
                        sys.stdout.write(f"\r\033[K{progress_line}")
                        sys.stdout.flush()

            except Exception:
                break
            time.sleep(0.5)
        try:
            s.close()
        except Exception:
            pass

    ipc_thread = threading.Thread(target=monitor_ipc, daemon=True)
    ipc_thread.start()

    try:
        if os.environ.get("ANINDO_DEBUG") == "1":
            proc = subprocess.Popen(mpv_cmd)
        else:
            proc = subprocess.Popen(mpv_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        proc.wait()
        ret_code = proc.returncode
    except KeyboardInterrupt:
        ret_code = 0
    finally:
        if sys.stdout.isatty():
            sys.stdout.write("\r\033[K\n")
            sys.stdout.flush()
        stop_event.set()
        ipc_thread.join(timeout=0.5)
        try:
            if os.path.islink(static_sock):
                if os.path.realpath(static_sock) == os.path.realpath(sock_path):
                    os.unlink(static_sock)
            elif os.path.exists(static_sock) and os.path.realpath(static_sock) == os.path.realpath(sock_path):
                os.unlink(static_sock)
        except Exception:
            pass

        if os.path.exists(sock_path):
            try:
                os.unlink(sock_path)
            except Exception:
                pass
        if input_conf_file and input_conf_file.exists():
            try:
                input_conf_file.unlink()
            except Exception:
                pass
        if server:
            server.shutdown()

    final_percent = playback_state.get("percent", 0.0)
    final_time = playback_state.get("time_pos", 0.0)
    final_duration = playback_state.get("duration", 0.0)

    # Threshold for completion: watched >= 85% or within 60s of ending
    if final_percent >= 85.0 or (final_duration > 60 and (final_duration - final_time) <= 60):
        status = "completed"
        save_time = 0
    elif final_time >= 2.0:
        status = "in_progress"
        save_time = int(final_time)
    elif start_pos and start_pos > 0:
        status = "in_progress"
        save_time = int(start_pos)
    else:
        status = "not_started"
        save_time = 0

    return (ret_code in (0, 2, 3) or final_time > 0), {
        "status": status,
        "time_pos": save_time,
        "percent": int(final_percent),
        "duration": int(final_duration),
        "ret_code": ret_code
    }

def download_video(url, title, quality_label="", referer=None, is_hls=False, dest_dir=None):
    """Download video stream with tiered accelerators: aria2c -> yt-dlp -> curl."""
    import shutil
    has_aria2 = bool(shutil.which("aria2c"))
    has_ytdlp = bool(shutil.which("yt-dlp"))

    if dest_dir:
        target_dir = Path(os.path.expanduser(dest_dir)).resolve()
    elif USER_CONFIG.get("download_dir"):
        target_dir = Path(os.path.expanduser(USER_CONFIG["download_dir"])).resolve()
    else:
        target_dir = get_default_download_dir()

    try:
        target_dir.mkdir(parents=True, exist_ok=True)
    except Exception as e:
        log_warn(f"Gagal membuat direktori {target_dir}: {e}, menggunakan direktori saat ini.")
        target_dir = Path.cwd()

    safe_name = re.sub(r'[^A-Za-z0-9._ -]+', '_', f"{title} [{quality_label}].mp4")
    dest_path = target_dir / safe_name
    dest_dir_str = str(target_dir)
    log_info(f"Mengunduh ke: {dest_path}")

    def notify_dl(msg):
        if not USER_CONFIG.get("notify", True):
            return
        try:
            subprocess.run(["notify-send", "-a", "anindo", "-i", "download", "anindo - Pengunduhan", msg],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        except Exception:
            pass
    threading.Thread(target=notify_dl, args=(f"Mulai: {safe_name}",), daemon=True).start()

    pref_dl = USER_CONFIG.get("preferred_downloader", "auto").lower()

    if is_hls:
        if pref_dl != "ffmpeg" and has_ytdlp:
            cmd = ["yt-dlp", "--progress", "-o", str(dest_path)]
            if has_aria2 and pref_dl != "curl":
                cmd.extend(["--downloader", "aria2c", "--downloader-args", "aria2c:-x 16 -s 16 -j 16 -k 1M"])
            if referer:
                cmd.extend(["--referer", referer])
            cmd.extend(["--add-header", f"User-Agent:{USER_AGENT}", url])
            try:
                ret = subprocess.run(cmd)
                if ret.returncode == 0:
                    log_success(f"Selesai mengunduh: {dest_path}")
                    threading.Thread(target=notify_dl, args=(f"Selesai: {safe_name}",), daemon=True).start()
                    return
            except Exception:
                pass
        cmd = ["ffmpeg", "-y"]
        if referer:
            cmd.extend(["-headers", f"Referer: {referer}\r\nUser-Agent: {USER_AGENT}\r\n"])
        else:
            cmd.extend(["-headers", f"User-Agent: {USER_AGENT}\r\n"])
        cmd.extend(["-i", url, "-c", "copy", str(dest_path)])
        try:
            subprocess.run(cmd)
            log_success(f"Selesai mengunduh: {dest_path}")
            threading.Thread(target=notify_dl, args=(f"Selesai: {safe_name}",), daemon=True).start()
            return
        except Exception as e:
            log_err(f"Gagal mengunduh stream HLS: {e}")
            return

    # Direct MP4 stream: try aria2c multi-connection acceleration first
    if pref_dl in ("aria2c", "auto") and has_aria2:
        aria_cmd = [
            "aria2c",
            "-x", "16",
            "-s", "16",
            "-j", "16",
            "-k", "1M",
            "--header", f"User-Agent: {USER_AGENT}",
            "-d", dest_dir_str,
            "-o", safe_name,
            "--allow-overwrite=true",
            "--summary-interval=2"
        ]
        if referer:
            aria_cmd.extend(["--header", f"Referer: {referer}"])
        aria_cmd.append(url)
        try:
            ret = subprocess.run(aria_cmd)
            if ret.returncode == 0:
                log_success(f"Selesai mengunduh via aria2c: {dest_path}")
                threading.Thread(target=notify_dl, args=(f"Selesai: {safe_name}",), daemon=True).start()
                return
        except Exception:
            pass

    # Universal fallback to curl
    dl_cmd = ["curl", "-L", "-H", f"User-Agent: {USER_AGENT}"]
    if referer:
        dl_cmd.extend(["-H", f"Referer: {referer}"])
    dl_cmd.extend(["-o", str(dest_path), "--progress-bar", url])
    subprocess.run(dl_cmd)
    log_success(f"Selesai mengunduh: {dest_path}")
    threading.Thread(target=notify_dl, args=(f"Selesai: {safe_name}",), daemon=True).start()

