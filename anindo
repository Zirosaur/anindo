def curl_get(url, referer=None, timeout=12):
    cmd = ["curl", "-s", "-L", "--max-time", str(timeout), "-H", f"User-Agent: {USER_AGENT}"]
    if referer:
        cmd.extend(["-H", f"Referer: {referer}"])
    cmd.append(url)
    try:
        return subprocess.check_output(cmd).decode("utf-8", "ignore")
    except Exception:
        return ""

def curl_redirect(url, timeout=5):
    cmd = ["curl", "-s", "-I", "--max-time", str(timeout), "-H", f"User-Agent: {USER_AGENT}", url]
    try:
        out = subprocess.check_output(cmd).decode("utf-8", "ignore")
        m = re.search(r"[Ll]ocation:\s*([^\r\n]+)", out)
        return m.group(1).strip() if m else None
    except Exception:
        return None

def resolve_pixeldrain(raw_href):
    loc = curl_redirect(raw_href, timeout=5)
    if not loc or "pixeldrain.com/u/" not in loc:
        return None
    file_id = loc.split("/u/")[1].split("/")[0]
    p_url = f"https://pixeldrain.com/api/file/{file_id}"
    
    # Pre-flight check: ensure it's not 451 DMCA / 404
    cmd = ["curl", "-s", "-I", "--max-time", "3", p_url]
    try:
        out = subprocess.check_output(cmd).decode("utf-8", "ignore")
        first_line = out.splitlines()[0] if out.splitlines() else ""
        if "200" in first_line:
            return p_url
        elif "451" in first_line:
            log_warn(f"Pixeldrain: Berkas diblokir DMCA (HTTP 451)")
        elif "404" in first_line:
            log_warn(f"Pixeldrain: Berkas tidak ditemukan (HTTP 404)")
        else:
            log_warn(f"Pixeldrain tidak merespon 200 OK: {first_line.strip()}")
    except Exception:
        pass
    return None

def resolve_filedon(raw_href):
    loc = curl_redirect(raw_href, timeout=5)
    if not loc:
        return None
    embed_url = loc.replace("/view/", "/embed/")
    try:
        page = curl_get(embed_url, timeout=5)
        m = re.search(r'data-page="([^"]+)"', page)
        if m:
            data = json.loads(html.unescape(m.group(1)))
            r2_url = data.get("props", {}).get("url")
            if r2_url:
                return r2_url
    except Exception:
        pass
    return None

def resolve_direct(raw_href):
    return raw_href

def fzf_select(items, prompt="Pilih: ", display_fn=str):
    """Interactive selection using fzf with keyboard navigation."""
    if not items:
        return None
    if len(items) == 1:
        return items[0]

    lines = []
    item_map = {}
    for i, item in enumerate(items):
        key = f"[{i+1:2d}] {display_fn(item)}"
        lines.append(key)
        item_map[key] = item

    try:
        proc = subprocess.Popen(
            ["fzf", "--reverse", "--cycle", "--prompt", prompt, "--height=45%", "--border"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True
        )
        selected_line, _ = proc.communicate(input="\n".join(lines))
        if proc.returncode == 0 and selected_line.strip():
            return item_map.get(selected_line.strip())
    except FileNotFoundError:
        print(f"\n{C_BOLD}{prompt}{C_RESET}")
        for line in lines:
            print(line)
        while True:
            try:
                choice = input(f"{prompt} (1-{len(items)}): ").strip()
                idx = int(choice) - 1
                if 0 <= idx < len(items):
                    return items[idx]
            except (ValueError, EOFError, KeyboardInterrupt):
                return None
    return None

def get_ongoing_anime():
    """Fetch latest ongoing anime releases."""
    log_info("Mengambil daftar anime on-going terbaru...")
    html_page = curl_get(f"{OTAKUDESU_BASE}/ongoing-anime/")
    items = []
    for m in re.finditer(r'<div class=[\'"]thumb[\'"]><a href=[\'"]([^\'"]+)[\'"].*?<h2 class=[\'"]jdlflm[\'"]>([^<]+)</h2>', html_page, re.DOTALL):
        url = m.group(1).strip()
        title = m.group(2).replace("&#8211;", "-").replace("&amp;", "&").strip()
        items.append({"title": f"{title} (Ongoing)", "url": url})
    return items

def search_anime(query):
    """Search for anime on Otakudesu."""
    log_info(f"Mencari '{query}'...")
    url = f"{OTAKUDESU_BASE}/?s={urllib.parse.quote(query)}&post_type=anime"
    html_page = curl_get(url)

    results = []
    matches = re.findall(r'<h2><a href="([^"]+)"[^>]*>([^<]+)</a></h2>', html_page)
    for link, title in matches:
        title = title.replace("&#8211;", "-").replace("&amp;", "&").strip()
        results.append({"title": title, "url": link})

    # Catalog fallback if search returns few results
    if len(results) < 3:
        catalog = get_catalog()
        q_lower = query.lower()
        for c in catalog:
            if q_lower in c["title"].lower():
                if not any(r["url"] == c["url"] for r in results):
                    results.append(c)

    return results

def get_catalog():
    """Get full anime index from Otakudesu with local cache."""
    if CATALOG_CACHE_FILE.exists():
        try:
            mtime = CATALOG_CACHE_FILE.stat().st_mtime
            import time
            if time.time() - mtime < 86400: # 24h cache
                with open(CATALOG_CACHE_FILE, "r") as f:
                    return json.load(f)
        except Exception:
            pass

    html_page = curl_get(f"{OTAKUDESU_BASE}/anime-list/")
    catalog = []
    links = re.findall(r'<a class="hodebgst"[^>]*href="([^"]+)"[^>]*>([^<]+)', html_page)
    for link, title in links:
        title = title.replace("&#8211;", "-").replace("&amp;", "&").strip()
        catalog.append({"title": title, "url": link})

    if catalog:
        try:
            with open(CATALOG_CACHE_FILE, "w") as f:
                json.dump(catalog, f)
        except Exception:
            pass

    return catalog

def get_anime_details(anime_url):
    """Fetch anime details and list of episodes."""
    log_info("Mengambil daftar episode...")
    html_page = curl_get(anime_url)

    raw_eps = re.findall(r'<a href="(https://otakudesu\.blog/episode/[^"]+)"[^>]*>([^<]+)</a>', html_page)
    episodes = []
    for link, title in raw_eps:
        clean_title = title.replace("&#8211;", "-").replace("&amp;", "&").replace("Subtitle Indonesia", "").strip()
        num_m = re.search(r'Episode\s*(\d+(?:\.\d+)?)', clean_title, re.IGNORECASE)
        ep_num = float(num_m.group(1)) if num_m else 0
        episodes.append({
            "title": clean_title,
            "url": link,
            "ep_num": ep_num
        })

    # Sort episodes ascending (1, 2, 3...)
    episodes.sort(key=lambda x: x["ep_num"] if x["ep_num"] > 0 else 9999)
    return episodes

def extract_stream_candidates(ep_url):
    """Extract all available stream candidate sources for an episode."""
    log_info("Mengekstrak opsi mirror Sub Indo...")
    html_page = curl_get(ep_url)
    candidates = []

    # 1. Check default iframe for odcdn / desustream
    iframes = re.findall(r'<iframe[^>]+src="([^"]+)"', html_page)
    for ifr in iframes:
        if "desustream" in ifr or "odcdn" in ifr:
            try:
                ifr_html = curl_get(ifr, referer=ep_url, timeout=5)
                v_urls = re.findall(r'videoURL\s*=\s*["\']([^"\']+)["\']', ifr_html)
                for v in v_urls:
                    candidates.append({
                        "quality": "720p",
                        "server": "ODCloud",
                        "href": v,
                        "resolver": resolve_direct
                    })
            except Exception:
                pass

    # 2. Check download section for mirrors (Filedon, Pixeldrain, etc.)
    m = re.search(r'<div class="download">(.*?)</div>', html_page, re.DOTALL)
    if m:
        dl_html = m.group(1)
        for li in re.findall(r'<li>(.*?)</li>', dl_html, re.DOTALL):
            q_m = re.search(r'<strong>(.*?)</strong>', li)
            quality = q_m.group(1).strip() if q_m else "720p"
            links = re.findall(r'<a href="([^"]+)"[^>]*>([^<]+)</a>', li)
            for href, host in links:
                host_clean = host.strip()
                if host_clean in ["Filedon"]:
                    candidates.append({
                        "quality": quality,
                        "server": "Filedon",
                        "href": href,
                        "resolver": resolve_filedon
                    })
                elif host_clean in ["Pdrain", "Pixeldrain", "PDrain"]:
                    candidates.append({
                        "quality": quality,
                        "server": "Pixeldrain",
                        "href": href,
                        "resolver": resolve_pixeldrain
                    })

    return candidates

def play_video(url, title, quality_label=""):
    """Play video stream via MPV."""
    log_success(f"Memutar: {title} ({quality_label})")
    mpv_cmd = [
        "mpv",
        f"--force-media-title=[Sub Indo] {title}",
        "--resume-playback=yes",
        "--save-position-on-quit=yes",
        "--keep-open=no",
        url
    ]
    try:
        ret = subprocess.run(mpv_cmd)
        return ret.returncode == 0
    except KeyboardInterrupt:
        return True # User stopped intentionally

def download_video(url, title, quality_label=""):
    """Download video stream with curl."""
    safe_name = re.sub(r'[^A-Za-z0-9._ -]+', '_', f"{title} [{quality_label}].mp4")
    dest_path = Path.cwd() / safe_name
    log_info(f"Mengunduh ke: {dest_path}")
    dl_cmd = ["curl", "-L", "-H", f"User-Agent: {USER_AGENT}", "-o", str(dest_path), "--progress-bar", url]
    subprocess.run(dl_cmd)
    log_success(f"Selesai mengunduh: {dest_path}")

def save_history(anime_title, anime_url, episode_title, episode_num, episode_url):
    """Save watch history to JSON."""
    history = {}
    if HISTORY_FILE.exists():
        try:
            with open(HISTORY_FILE, "r") as f:
                history = json.load(f)
        except Exception:
            history = {}

    import time
    history[anime_url] = {
        "anime_title": anime_title,
        "anime_url": anime_url,
        "last_ep_title": episode_title,
        "last_ep_num": episode_num,
        "last_ep_url": episode_url,
        "timestamp": int(time.time())
    }

    try:
        with open(HISTORY_FILE, "w") as f:
            json.dump(history, f, indent=2)
    except Exception:
        pass

def load_history():
    """Load watch history sorted by recent."""
    if not HISTORY_FILE.exists():
        return []
    try:
        with open(HISTORY_FILE, "r") as f:
            data = json.load(f)
            items = list(data.values())
            items.sort(key=lambda x: x.get("timestamp", 0), reverse=True)
            return items
    except Exception:
        return []

def main():
    parser = argparse.ArgumentParser(
        prog="anindo",
        description="anindo - Streaming Anime Subtitle Indonesia via Terminal (CLI)",
        epilog="Contoh:\n  anindo frieren\n  anindo 'one piece' -e 1177\n  anindo -o (lihat anime ongoing terbaru)\n  anindo -c (lanjutkan tontonan terakhir)\n  anindo -q 720p naruto",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("query", nargs="?", help="Judul anime yang dicari")
    parser.add_argument("-e", "--episode", type=float, help="Nomor episode langsung (misal: -e 10)")
    parser.add_argument("-q", "--quality", choices=["360", "480", "720", "1080", "best"], default="best", help="Kualitas video (default: best)")
    parser.add_argument("-o", "--ongoing", action="store_true", help="Pilih dari daftar anime on-going terbaru")
    parser.add_argument("-c", "--continue-watch", dest="continue_watch", action="store_true", help="Lanjutkan anime dari riwayat terakhir")
    parser.add_argument("-d", "--download", action="store_true", help="Unduh video ke lokal alih-alih memutar")
    parser.add_argument("--history", action="store_true", help="Tampilkan riwayat anime yang pernah ditonton")
    parser.add_argument("-V", "--version", action="version", version=f"anindo v{VERSION}")

    args = parser.parse_args()

    # Print banner
    print(f"{C_CYAN}{C_BOLD}╔══════════════════════════════════════════════════╗{C_RESET}")
    print(f"{C_CYAN}{C_BOLD}║      anindo - Anime Subtitle Indonesia CLI       ║{C_RESET}")
    print(f"{C_CYAN}{C_BOLD}╚══════════════════════════════════════════════════╝{C_RESET}\n")

    selected_anime = None
    target_ep_num = args.episode

    if args.history:
        hist = load_history()
        if not hist:
            print("Belum ada riwayat tontonan.")
            return
        print(f"{C_BOLD}Riwayat Tontonan:{C_RESET}")
        for i, h in enumerate(hist[:10], 1):
            print(f" {i}. {h['anime_title']} - Terakhir: {h['last_ep_title']}")
        return

    if args.ongoing:
        ongoing_list = get_ongoing_anime()
        if not ongoing_list:
            log_err("Gagal mengambil daftar anime ongoing.")
            return
        selected_anime = fzf_select(ongoing_list, prompt="Pilih Anime Ongoing: ", display_fn=lambda x: x["title"])
    elif args.continue_watch:
        hist = load_history()
        if not hist:
            log_warn("Tidak ada riwayat tontonan untuk dilanjutkan.")
            return
        choice = fzf_select(hist, prompt="Lanjutkan Anime: ", display_fn=lambda x: f"{x['anime_title']} ({x['last_ep_title']})")
        if not choice:
            return
        selected_anime = {"title": choice["anime_title"], "url": choice["anime_url"]}
        target_ep_num = choice["last_ep_num"]
    else:
        query = args.query
        if not query:
            menu_items = [
                {"action": "search", "title": "🔍 Cari Anime"},
                {"action": "ongoing", "title": "🔥 Anime On-Going Terbaru"},
                {"action": "history", "title": "🕒 Lanjutkan Tontonan Terakhir"}
            ]
            menu_pick = fzf_select(menu_items, prompt="Menu Utama: ", display_fn=lambda x: x["title"])
            if not menu_pick:
                return

            if menu_pick["action"] == "ongoing":
                ongoing_list = get_ongoing_anime()
                selected_anime = fzf_select(ongoing_list, prompt="Pilih Anime Ongoing: ", display_fn=lambda x: x["title"])
            elif menu_pick["action"] == "history":
                hist = load_history()
                if not hist:
                    log_warn("Belum ada riwayat tontonan.")
                    return
                choice = fzf_select(hist, prompt="Lanjutkan Anime: ", display_fn=lambda x: f"{x['anime_title']} ({x['last_ep_title']})")
                if not choice:
                    return
                selected_anime = {"title": choice["anime_title"], "url": choice["anime_url"]}
                target_ep_num = choice["last_ep_num"]
            else:
                try:
                    query = input(f"{C_BOLD}Ketik judul anime: {C_RESET}").strip()
                except (EOFError, KeyboardInterrupt):
                    return
                if not query:
                    return
                results = search_anime(query)
                if not results:
                    log_err(f"Anime '{query}' tidak ditemukan.")
                    return
                selected_anime = fzf_select(results, prompt="Pilih Anime: ", display_fn=lambda x: x["title"])
        else:
            results = search_anime(query)
            if not results:
                log_err(f"Anime '{query}' tidak ditemukan.")
                return
            selected_anime = fzf_select(results, prompt="Pilih Anime: ", display_fn=lambda x: x["title"])

    if not selected_anime:
        return

    log_success(f"Memilih: {selected_anime['title']}")
    episodes = get_anime_details(selected_anime["url"])
    if not episodes:
        log_err("Tidak dapat menemukan daftar episode untuk anime ini.")
        return

    # Determine episode index
    cur_ep_idx = 0
    if target_ep_num is not None:
        matched = [(i, ep) for i, ep in enumerate(episodes) if ep["ep_num"] == target_ep_num]
        if matched:
            cur_ep_idx = matched[0][0]
        else:
            log_warn(f"Episode {target_ep_num} tidak ditemukan, silakan pilih manual.")
            selected_ep = fzf_select(episodes, prompt="Pilih Episode: ", display_fn=lambda x: x["title"])
            if not selected_ep:
                return
            cur_ep_idx = episodes.index(selected_ep)
    else:
        selected_ep = fzf_select(episodes, prompt="Pilih Episode: ", display_fn=lambda x: x["title"])
        if not selected_ep:
            return
        cur_ep_idx = episodes.index(selected_ep)

    # Main streaming loop (supports auto-next episode and mirror fallback)
    while cur_ep_idx < len(episodes):
        ep = episodes[cur_ep_idx]
        log_info(f"Memproses {ep['title']}...")
        candidates = extract_stream_candidates(ep["url"])
        if not candidates:
            log_err(f"Tidak ada server video yang ditemukan untuk {ep['title']}.")
            if cur_ep_idx + 1 < len(episodes):
                try:
                    c = input("Coba episode selanjutnya? [Y/n]: ").strip().lower()
                    if c in ("", "y", "ya", "yes"):
                        cur_ep_idx += 1
                        continue
                except (EOFError, KeyboardInterrupt):
                    pass
            break

        # Ranking function based on user quality preference and server reliability
        def score_candidate(c):
            s = 0
            q = c["quality"]
            # Quality weighting
            if args.quality != "best":
                if args.quality in q:
                    s += 1000
            if "1080" in q: s += 300
            elif "720" in q: s += 200
            elif "480" in q: s += 100
            elif "360" in q: s += 50

            # Server priority: Filedon & Pixeldrain are direct fast CDNs
            if c["server"] == "Filedon": s += 15
            elif c["server"] == "Pixeldrain": s += 10
            elif c["server"] == "ODCloud": s += 8
            return s

        candidates.sort(key=score_candidate, reverse=True)

        played_successfully = False
        for cand in candidates:
            s_name = cand["server"]
            s_qual = cand["quality"]
            log_info(f"Mencoba server {s_name} ({s_qual})...")
            stream_url = cand["resolver"](cand["href"])
            if not stream_url:
                log_warn(f"Server {s_name} ({s_qual}) tidak tersedia, mencoba alternatif berikutnya...")
                continue

            save_history(selected_anime["title"], selected_anime["url"], ep["title"], ep["ep_num"], ep["url"])

            if args.download:
                download_video(stream_url, f"{selected_anime['title']} - {ep['title']}", s_qual)
                played_successfully = True
                break
            else:
                ok = play_video(stream_url, f"{selected_anime['title']} - {ep['title']}", f"{s_qual} - {s_name}")
                if ok:
                    played_successfully = True
                    break
                else:
                    log_warn(f"Pemutaran video terputus atau gagal di {s_name}, mencoba server lain...")

        if not played_successfully:
            log_err(f"Semua server alternatif untuk {ep['title']} gagal dimuat.")

        # Next episode prompt
        if cur_ep_idx + 1 < len(episodes):
            next_ep = episodes[cur_ep_idx + 1]
            try:
                print()
                ans = input(f"{C_CYAN}Putar episode berikutnya ({next_ep['title']})? [Y/n]: {C_RESET}").strip().lower()
                if ans in ("", "y", "ya", "yes"):
                    cur_ep_idx += 1
                    continue
                else:
                    break
            except (EOFError, KeyboardInterrupt):
                print()
                break
        else:
            log_success("Ini adalah episode terakhir dari seri ini!")
            break

if __name__ == "__main__":
    main()
