class DOMParser(HTMLParser):
    """Resilient DOM Tokenizer that extracts links, meta tags, and iframes without regex fragility."""
    def __init__(self):
        super().__init__()
        self.links = []
        self.meta = {}
        self.iframes = []
        self.json_ld = []
        self._cur_a = None
        self._in_json_ld = False
        self._json_ld_buf = ""

    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        if tag == "a" and "href" in d:
            self._cur_a = {"href": d["href"], "text": "", "title": d.get("title", ""), "attrs": d}
        elif tag == "meta":
            k = d.get("property") or d.get("name")
            if k and "content" in d:
                self.meta[k] = d["content"]
        elif tag == "iframe" and "src" in d:
            self.iframes.append(d["src"])
        elif tag == "script" and d.get("type") == "application/ld+json":
            self._in_json_ld = True
            self._json_ld_buf = ""

    def handle_endtag(self, tag):
        if tag == "a" and self._cur_a:
            self._cur_a["text"] = " ".join(self._cur_a["text"].split())
            self.links.append(self._cur_a)
            self._cur_a = None
        elif tag == "script" and self._in_json_ld:
            self._in_json_ld = False
            if self._json_ld_buf.strip():
                try:
                    self.json_ld.append(json.loads(self._json_ld_buf))
                except Exception:
                    pass

    def handle_data(self, data):
        if self._cur_a is not None:
            self._cur_a["text"] += " " + data.strip()
        elif self._in_json_ld:
            self._json_ld_buf += data

