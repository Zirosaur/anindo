def check_and_self_update():
    """Check GitHub releases and self-update anindo binary."""
    log_info(f"Memeriksa versi terbaru dari GitHub... (versi saat ini: v{VERSION})")
    api_url = "https://api.github.com/repos/Zirosaur/anindo/releases/latest"
    try:
        raw_json = curl_get(api_url, timeout=6)
        if not raw_json:
            log_err("Gagal terhubung ke GitHub API untuk memeriksa pembaruan.")
            return
        rel = json.loads(raw_json)
        latest_tag = rel.get("tag_name", "").lstrip("v")
        if not latest_tag:
            log_warn("Tidak dapat membaca tag rilis terbaru dari respons GitHub.")
            return

        def parse_ver(v):
            return tuple(int(x) if x.isdigit() else 0 for x in v.split("."))

        if parse_ver(latest_tag) <= parse_ver(VERSION):
            log_success(f"anindo sudah menggunakan versi terbaru (v{VERSION})!")
            return

        log_info(f"Versi baru tersedia: v{latest_tag}! Mengunduh pembaruan...")
        bin_path = Path(sys.argv[0]).resolve()

        # Safety: avoid overwriting if run inside a git repo workspace
        if (bin_path.parent / ".git").exists() or (bin_path.parent.parent / ".git").exists():
            log_warn(f"Skrip dijalankan dari repositori Git lokal ({bin_path}).")
            log_info("Gunakan 'git pull' untuk memperbarui kode pengembangan.")
            return

        raw_script_url = "https://raw.githubusercontent.com/Zirosaur/anindo/main/anindo"
        script_code = curl_get(raw_script_url, timeout=12)
        if not script_code or "anindo" not in script_code:
            log_err("Gagal mengunduh skrip pembaruan.")
            return

        tmp_target = bin_path.with_name(f".anindo_update_{os.getpid()}")
        with open(tmp_target, "w", encoding="utf-8") as f:
            f.write(script_code)
        tmp_target.chmod(0o755)
        tmp_target.replace(bin_path)

        log_success(f"Berhasil memperbarui anindo ke v{latest_tag} di {bin_path}!")
    except Exception as e:
        log_err(f"Gagal melakukan pembaruan mandiri: {e}")

def parse_episode_spec(spec: str, episodes: list[dict]) -> list[dict]:
    """
    Parse episode specification like '1-12', '1,3,5', 'all', '1-5,8'
    and return matching episode items from the given list.
    """
    if not spec or not episodes:
        return []

    spec_str = str(spec).strip().lower()
    if spec_str in ("all", "*", "semua"):
        return list(episodes)

    matched_indices = set()
    parts = [p.strip() for p in spec_str.split(",") if p.strip()]

    for part in parts:
        if "-" in part:
            range_parts = [rp.strip() for rp in part.split("-") if rp.strip()]
            if len(range_parts) == 2:
                try:
                    start_val = float(range_parts[0])
                    end_val = float(range_parts[1])
                    low = min(start_val, end_val)
                    high = max(start_val, end_val)
                    for i, ep in enumerate(episodes):
                        ep_num = ep.get("ep_num", 0)
                        if low <= ep_num <= high:
                            matched_indices.add(i)
                except ValueError:
                    continue
        else:
            try:
                target_val = float(part)
                for i, ep in enumerate(episodes):
                    if ep.get("ep_num") == target_val:
                        matched_indices.add(i)
            except ValueError:
                continue

    return [episodes[i] for i in sorted(matched_indices)]

def fzf_select(items, prompt="Pilih: ", display_fn=str):
    """Interactive selection using fzf with keyboard navigation and CLI fallback."""
    if not items:
        return None
    if len(items) == 1:
        return items[0]

    lines = []
    item_map = {}
    for i, item in enumerate(items):
        key = f"[{i+1:2d}] {display_fn(item)}"
        lines.append(key)
        item_map[key] = item

    try:
        proc = subprocess.Popen(
            ["fzf", "--reverse", "--cycle", "--prompt", prompt, "--height=45%", "--border"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True
        )
        selected_line, _ = proc.communicate(input="\n".join(lines))
        if proc.returncode == 0 and selected_line.strip():
            return item_map.get(selected_line.strip())
    except (FileNotFoundError, OSError):
        print(f"\n{C_BOLD}{prompt}{C_RESET}")
        for line in lines:
            print(line)
        while True:
            try:
                choice = input(f"{prompt} (1-{len(items)}): ").strip()
                idx = int(choice) - 1
                if 0 <= idx < len(items):
                    return items[idx]
            except (ValueError, EOFError, KeyboardInterrupt):
                return None
    return None

