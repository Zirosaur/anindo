class BaseProvider(ABC):
    """Abstract interface for all anime streaming providers."""
    name: str = ""
    display_name: str = ""

    @abstractmethod
    def search(self, query: str) -> list[dict]:
        """Search anime: returns list of dicts with 'title', 'raw_title', 'url', 'provider'."""
        pass

    @abstractmethod
    def get_episodes(self, anime_url: str) -> list[dict]:
        """Fetch episode list: returns list of dicts with 'title', 'url', 'ep_num', 'provider'."""
        pass

    @abstractmethod
    def extract_streams(self, ep_url: str) -> list[dict]:
        """Extract stream candidates: returns list of dicts with 'quality', 'server', 'is_hls', 'resolve_fn'."""
        pass

    def get_ongoing(self) -> list[dict]:
        """Optional: fetch ongoing anime."""
        return []

    def get_catalog(self) -> list[dict]:
        """Optional: fetch full catalog index."""
        return []

class OtakudesuProvider(BaseProvider):
    """Provider implementation for Otakudesu (Modern Anime, Ongoing, BD Batches)."""
    name = "otakudesu"
    display_name = "Otakudesu"

    def search(self, query: str) -> list[dict]:
        base = get_base_url(self.name)
        rules = get_rules()
        search_path = rules.get(self.name, {}).get("search_path", "/?s={query}&post_type=anime").format(query=urllib.parse.quote(query))
        html_page = curl_get(f"{base}{search_path}")

        parser = DOMParser()
        parser.feed(html_page)

        results = []
        seen = set()
        for l in parser.links:
            href = l["href"]
            if "/anime/" in href and href not in seen:
                t = l["text"] or l["title"]
                if t and len(t) > 3 and not any(k in t.lower() for k in ["home", "anime list", "jadwal", "ongoing"]):
                    seen.add(href)
                    clean = t.replace("&#8211;", "-").replace("&amp;", "&").strip()
                    results.append({
                        "title": f"{clean} [{self.display_name}]",
                        "raw_title": clean,
                        "url": href,
                        "provider": self.name
                    })

        if not results:
            matches = re.findall(r'<h2><a href="([^"]+)"[^>]*>([^<]+)</a></h2>', html_page)
            for link, title in matches:
                if link not in seen:
                    seen.add(link)
                    clean = title.replace("&#8211;", "-").replace("&amp;", "&").strip()
                    results.append({
                        "title": f"{clean} [{self.display_name}]",
                        "raw_title": clean,
                        "url": link,
                        "provider": self.name
                    })

        if len(results) < 3:
            catalog = self.get_catalog()
            q_lower = query.lower()
            for c in catalog:
                if q_lower in c["raw_title"].lower() and not any(r["url"] == c["url"] for r in results):
                    results.append(c)

        return results

    def get_catalog(self) -> list[dict]:
        if CATALOG_CACHE_FILE.exists():
            try:
                mtime = CATALOG_CACHE_FILE.stat().st_mtime
                if time.time() - mtime < 86400:
                    with open(CATALOG_CACHE_FILE, "r") as f:
                        return json.load(f)
            except Exception:
                pass

        base = get_base_url(self.name)
        rules = get_rules()
        catalog_path = rules.get(self.name, {}).get("catalog_path", "/anime-list/")
        html_page = curl_get(f"{base}{catalog_path}")

        parser = DOMParser()
        parser.feed(html_page)

        catalog = []
        seen = set()
        for l in parser.links:
            href = l["href"]
            if "/anime/" in href and href not in seen:
                t = l["text"]
                if t and len(t) > 2:
                    seen.add(href)
                    clean = t.replace("&#8211;", "-").replace("&amp;", "&").strip()
                    catalog.append({
                        "title": f"{clean} [{self.display_name}]",
                        "raw_title": clean,
                        "url": href,
                        "provider": self.name
                    })

        if catalog:
            try:
                with open(CATALOG_CACHE_FILE, "w") as f:
                    json.dump(catalog, f)
            except Exception:
                pass
        return catalog

    def get_ongoing(self) -> list[dict]:
        base = get_base_url(self.name)
        rules = get_rules()
        ongoing_path = rules.get(self.name, {}).get("ongoing_path", "/ongoing-anime/")
        html_page = curl_get(f"{base}{ongoing_path}")

        parser = DOMParser()
        parser.feed(html_page)

        items = []
        seen = set()
        for link in parser.links:
            href = link["href"]
            if "/anime/" in href and href not in seen:
                t = link["text"] or link["title"]
                if t and len(t) > 3 and "ongoing" not in t.lower():
                    seen.add(href)
                    clean = t.replace("&#8211;", "-").replace("&amp;", "&").strip()
                    items.append({
                        "title": f"{clean} (Ongoing) [{self.display_name}]",
                        "raw_title": clean,
                        "url": href,
                        "provider": self.name
                    })

        if len(items) < 3:
            for m in re.finditer(r'<div class=[\'"]thumb[\'"]><a href=[\'"]([^\'"]+)[\'"].*?<h2 class=[\'"]jdlflm[\'"]>([^<]+)</h2>', html_page, re.DOTALL):
                url = m.group(1).strip()
                if url not in seen:
                    seen.add(url)
                    clean = m.group(2).replace("&#8211;", "-").replace("&amp;", "&").strip()
                    items.append({
                        "title": f"{clean} (Ongoing) [{self.display_name}]",
                        "raw_title": clean,
                        "url": url,
                        "provider": self.name
                    })
