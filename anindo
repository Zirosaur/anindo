def curl_get(url, referer=None, timeout=12):
    cmd = ["curl", "-s", "-L", "--max-time", str(timeout), "-H", f"User-Agent: {USER_AGENT}"]
    if referer:
        cmd.extend(["-H", f"Referer: {referer}"])
    cmd.append(url)
    try:
        return subprocess.check_output(cmd).decode("utf-8", "ignore")
    except Exception:
        return ""

def curl_redirect(url, timeout=5):
    cmd = ["curl", "-s", "-I", "--max-time", str(timeout), "-H", f"User-Agent: {USER_AGENT}", url]
    try:
        out = subprocess.check_output(cmd).decode("utf-8", "ignore")
        m = re.search(r"[Ll]ocation:\s*([^\r\n]+)", out)
        return m.group(1).strip() if m else None
    except Exception:
        return None

def curl_post_ajax(body_dict, referer, timeout=6):
    body_str = "&".join(f"{k}={v}" for k, v in body_dict.items())
    cmd = [
        "curl", "-s", "-X", "POST", f"{OTAKUDESU_BASE}/wp-admin/admin-ajax.php",
        "-H", f"User-Agent: {USER_AGENT}",
        "-H", f"Referer: {referer}",
        "-H", f"Origin: {OTAKUDESU_BASE}",
        "-H", "X-Requested-With: XMLHttpRequest",
        "--max-time", str(timeout),
        "-d", body_str
    ]
    try:
        out = subprocess.check_output(cmd).decode("utf-8", "ignore")
        return json.loads(out)
    except Exception:
        return {}

def resolve_pixeldrain(raw_href):
    loc = curl_redirect(raw_href, timeout=5)
    if not loc or "pixeldrain.com/u/" not in loc:
        return None, None
    file_id = loc.split("/u/")[1].split("/")[0]
    p_url = f"https://pixeldrain.com/api/file/{file_id}"
    
    # Pre-flight check: ensure it's not 451 DMCA / 404
    cmd = ["curl", "-s", "-I", "--max-time", "3", p_url]
    try:
        out = subprocess.check_output(cmd).decode("utf-8", "ignore")
        first_line = out.splitlines()[0] if out.splitlines() else ""
        if "200" in first_line:
            return p_url, None
        elif "451" in first_line:
            log_warn("Pixeldrain: Berkas diblokir DMCA (HTTP 451)")
        elif "404" in first_line:
            log_warn("Pixeldrain: Berkas tidak ditemukan (HTTP 404)")
        else:
            log_warn(f"Pixeldrain tidak merespon 200 OK: {first_line.strip()}")
    except Exception:
        pass
    return None, None

def resolve_filedon(raw_href):
    loc = curl_redirect(raw_href, timeout=5) if "desustream" in raw_href else raw_href
    if not loc:
        return None, None
    embed_url = loc.replace("/view/", "/embed/")
    try:
        page = curl_get(embed_url, timeout=5)
        m = re.search(r'data-page="([^"]+)"', page)
        if m:
            data = json.loads(html.unescape(m.group(1)))
            r2_url = data.get("props", {}).get("url")
            if r2_url:
                return r2_url, None
    except Exception:
        pass
    return None, None

def resolve_yourupload_embed(embed_url):
    m_id = re.search(r'id=([A-Za-z0-9_-]+)', embed_url)
    if not m_id:
        m_id = re.search(r'/embed/([A-Za-z0-9_-]+)', embed_url)
    if not m_id:
        return None, None
    yu_id = m_id.group(1)
    page = curl_get(f"https://yourupload.com/embed/{yu_id}", referer="https://desudrive.com/", timeout=6)
    v_match = re.search(r"file\s*:\s*['\"](https?://[^'\"]+\.mp4[^'\"]*)['\"]", page)
    if not v_match:
        v_match = re.search(r'property="og:video"\s+content="([^"]+)"', page)
    if v_match:
        return v_match.group(1), "https://yourupload.com/"
    return None, None

def resolve_mirror_stream(ep_url, data_b64, mirror_name, actions):
    if len(actions) < 2:
        return None, None
    nonce_data = curl_post_ajax({"action": actions[1]}, referer=ep_url)
    nonce = nonce_data.get("data")
    if not nonce:
        return None, None

    payload = json.loads(base64.b64decode(data_b64).decode("utf-8"))
    payload["nonce"] = nonce
    payload["action"] = actions[0]

    resp = curl_post_ajax(payload, referer=ep_url)
    embed_b64 = resp.get("data", "")
    if not embed_b64:
        return None, None
    embed_html = base64.b64decode(embed_b64).decode("utf-8", "ignore")
    src_m = re.search(r'src=["\']([^"\']+)["\']', embed_html)
    if not src_m:
        return None, None
    src_url = src_m.group(1)

    if "yourupload" in mirror_name.lower() or "yuplod" in src_url:
        return resolve_yourupload_embed(src_url)
    elif "filedon" in mirror_name.lower() or "filedon" in src_url:
        return resolve_filedon(src_url)
    
    return src_url, None

def resolve_putarin(embed_url):
    """Decrypt Putarin/Puterin player config to obtain HLS m3u8 stream URL."""
    if AESGCM is None:
        log_err("Modul 'cryptography' belum terpasang. Jalankan: pip install cryptography")
        return None, None

    domain = urllib.parse.urlparse(embed_url).netloc
    page_html = curl_get(embed_url, referer=f"https://{domain}/", timeout=8)
    m = re.search(r'window\.__PX\s*=\s*(\{.*?\});', page_html)
    if not m:
        return None, None

    try:
        px = json.loads(m.group(1))
        n_val = px.get("n", "")
        d_b64 = px.get("d", "")

        pk_url = f"https://{domain}/api/pk?n={urllib.parse.quote(n_val)}"
        k_hex = curl_get(pk_url, referer=embed_url, timeout=6).strip()
        if not k_hex or len(k_hex) < 64:
            return None, None

        key = bytes.fromhex(k_hex)
        raw_d = base64.b64decode(d_b64)
        iv = raw_d[:12]
        ct = raw_d[12:]

        aes = AESGCM(key)
        pt = aes.decrypt(iv, ct, None)
        cfg = json.loads(pt.decode("utf-8"))
        file_path = cfg.get("file", "")
        if not file_path:
            return None, None

        if file_path.startswith("/"):
            file_path = f"https://{domain}" + file_path
        return file_path, f"https://{domain}/"
    except Exception as e:
        log_warn(f"Gagal mendekripsi stream Putarin: {e}")
        return None, None

def fix_m3u8_content(content_str, base_url):
    """Normalize protocol-relative and relative URLs in m3u8 playlists for local playback."""
    parsed = urllib.parse.urlparse(base_url)
    base_scheme = parsed.scheme or "https"
    base_netloc = parsed.netloc

    out_lines = []
    for line in content_str.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith("#"):
            def repl_uri(m):
                u = m.group(1)
                if u.startswith("//"):
                    return f'URI="{base_scheme}:{u}"'
                elif u.startswith("/"):
                    return f'URI="{base_scheme}://{base_netloc}{u}"'
                return m.group(0)
            out_lines.append(re.sub(r'URI="([^"]+)"', repl_uri, line))
        else:
            if stripped.startswith("//"):
                out_lines.append(f"{base_scheme}:{stripped}")
            elif stripped.startswith("/"):
                out_lines.append(f"{base_scheme}://{base_netloc}{stripped}")
            elif not (stripped.startswith("http://") or stripped.startswith("https://")):
                base_dir = base_url.rsplit("/", 1)[0]
                out_lines.append(f"{base_dir}/{stripped}")
            else:
                out_lines.append(stripped)
    return "\n".join(out_lines).encode("utf-8")

def fzf_select(items, prompt="Pilih: ", display_fn=str):
    """Interactive selection using fzf with keyboard navigation."""
    if not items:
        return None
    if len(items) == 1:
        return items[0]

    lines = []
    item_map = {}
    for i, item in enumerate(items):
        key = f"[{i+1:2d}] {display_fn(item)}"
        lines.append(key)
        item_map[key] = item

    try:
        proc = subprocess.Popen(
            ["fzf", "--reverse", "--cycle", "--prompt", prompt, "--height=45%", "--border"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True
        )
        selected_line, _ = proc.communicate(input="\n".join(lines))
        if proc.returncode == 0 and selected_line.strip():
            return item_map.get(selected_line.strip())
    except FileNotFoundError:
        print(f"\n{C_BOLD}{prompt}{C_RESET}")
        for line in lines:
            print(line)
        while True:
            try:
                choice = input(f"{prompt} (1-{len(items)}): ").strip()
                idx = int(choice) - 1
                if 0 <= idx < len(items):
                    return items[idx]
            except (ValueError, EOFError, KeyboardInterrupt):
                return None
    return None

def get_ongoing_anime():
    """Fetch latest ongoing anime releases from Otakudesu."""
    log_info("Mengambil daftar anime on-going terbaru...")
    html_page = curl_get(f"{OTAKUDESU_BASE}/ongoing-anime/")
    items = []
    for m in re.finditer(r'<div class=[\'"]thumb[\'"]><a href=[\'"]([^\'"]+)[\'"].*?<h2 class=[\'"]jdlflm[\'"]>([^<]+)</h2>', html_page, re.DOTALL):
        url = m.group(1).strip()
        title = m.group(2).replace("&#8211;", "-").replace("&amp;", "&").strip()
        items.append({
            "title": f"{title} (Ongoing) [Otakudesu]",
            "raw_title": title,
            "url": url,
            "provider": "otakudesu"
        })
    return items

def search_otakudesu(query):
    """Search for anime on Otakudesu."""
    url = f"{OTAKUDESU_BASE}/?s={urllib.parse.quote(query)}&post_type=anime"
    html_page = curl_get(url)

    results = []
    matches = re.findall(r'<h2><a href="([^"]+)"[^>]*>([^<]+)</a></h2>', html_page)
    for link, title in matches:
        title = title.replace("&#8211;", "-").replace("&amp;", "&").strip()
        results.append({
            "title": f"{title} [Otakudesu]",
            "raw_title": title,
            "url": link,
            "provider": "otakudesu"
        })

    # Catalog fallback if search returns few results
    if len(results) < 3:
        catalog = get_catalog()
        q_lower = query.lower()
        for c in catalog:
            if q_lower in c["raw_title"].lower():
                if not any(r["url"] == c["url"] for r in results):
                    results.append(c)

    return results

def get_catalog():
    """Get full anime index from Otakudesu with local cache."""
    if CATALOG_CACHE_FILE.exists():
        try:
            mtime = CATALOG_CACHE_FILE.stat().st_mtime
            if time.time() - mtime < 86400: # 24h cache
                with open(CATALOG_CACHE_FILE, "r") as f:
                    return json.load(f)
        except Exception:
            pass

    html_page = curl_get(f"{OTAKUDESU_BASE}/anime-list/")
    catalog = []
    links = re.findall(r'<a class="hodebgst"[^>]*href="([^"]+)"[^>]*>([^<]+)', html_page)
    for link, title in links:
        title = title.replace("&#8211;", "-").replace("&amp;", "&").strip()
        catalog.append({
            "title": f"{title} [Otakudesu]",
            "raw_title": title,
            "url": link,
            "provider": "otakudesu"
        })

    if catalog:
        try:
            with open(CATALOG_CACHE_FILE, "w") as f:
                json.dump(catalog, f)
        except Exception:
            pass

    return catalog

def search_nontonanime(query):
    """Search for anime on NontonAnime (great for classic/vintage 90s-2000s anime)."""
    url = f"{NONTONANIME_BASE}/?s={urllib.parse.quote(query)}"
    html_page = curl_get(url)
    articles = re.findall(r'<article[^>]*>(.*?)</article>', html_page, re.DOTALL)
    results = []
    for a in articles:
        link_m = re.search(r'href=[\"\'](https://ww2\.nontonanime\.co/anime/[^\"\']+)[\"\']', a)
        if not link_m:
            continue
        link = link_m.group(1)
        title_m = re.search(r'<h3[^>]*class=[\"\'][^\"\']*kk-name[^\"\']*[\"\'][^>]*>(.*?)</h3>', a, re.DOTALL) or re.search(r'title=[\"\']([^\"\']+)[\"\']', a)
        raw_title = title_m.group(1) if title_m else "Unknown"
        clean_title = re.sub(r'<[^>]+>', '', raw_title).strip()
        ep_m = re.search(r'class=[\"\']kk-badge kk-badge-ep[\"\'][^>]*>([^<]+)</span>', a)
        ep_info = f" ({ep_m.group(1).strip()})" if ep_m else ""
        results.append({
            "title": f"{clean_title}{ep_info} [NontonAnime]",
            "raw_title": clean_title,
            "url": link,
            "provider": "nontonanime"
        })
    return results

def search_anime(query, provider="all"):
    """Search for anime across sources concurrently."""
    log_info(f"Mencari '{query}'...")
    results = []

    if provider == "otakudesu":
        return search_otakudesu(query)
    elif provider == "nontonanime":
        return search_nontonanime(query)

    # Concurrently search both providers
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
        f_otaku = executor.submit(search_otakudesu, query)
        f_nonton = executor.submit(search_nontonanime, query)
        try:
            results.extend(f_otaku.result())
        except Exception:
            pass
        try:
            results.extend(f_nonton.result())
        except Exception:
            pass

    return results

def get_otakudesu_episodes(anime_url):
    """Fetch Otakudesu episodes list."""
    html_page = curl_get(anime_url)
    raw_eps = re.findall(r'<a href="(https://otakudesu\.blog/episode/[^"]+)"[^>]*>([^<]+)</a>', html_page)
    episodes = []
    for link, title in raw_eps:
        clean_title = title.replace("&#8211;", "-").replace("&amp;", "&").replace("Subtitle Indonesia", "").strip()
        num_m = re.search(r'Episode\s*(\d+(?:\.\d+)?)', clean_title, re.IGNORECASE)
        ep_num = float(num_m.group(1)) if num_m else 0
        episodes.append({
            "title": clean_title,
            "url": link,
            "ep_num": ep_num,
            "provider": "otakudesu"
        })
    episodes.sort(key=lambda x: x["ep_num"] if x["ep_num"] > 0 else 9999)
    return episodes

def get_nontonanime_episodes(anime_url):
    """Fetch NontonAnime episodes list."""
    html_page = curl_get(anime_url)
    matches = re.findall(r'<a\s+[^>]*href=[\"\'](https://ww2\.nontonanime\.co/nonton/[^\"\']+)[\"\'][^>]*>(.*?)</a>', html_page, re.DOTALL)
    episodes = {}
    for href, inner in matches:
        m = re.search(r'episode-(\d+(?:\.\d+)?)', href)
        if m:
            ep_num = float(m.group(1))
            if ep_num not in episodes:
                clean_title = f"Episode {int(ep_num) if ep_num.is_integer() else ep_num}"
                episodes[ep_num] = {
                    "title": clean_title,
                    "url": href,
                    "ep_num": ep_num,
                    "provider": "nontonanime"
                }
    sorted_eps = [episodes[k] for k in sorted(episodes.keys())]
    return sorted_eps

def get_anime_details(anime_item):
    """Fetch anime episodes based on provider."""
    log_info("Mengambil daftar episode...")
    provider = anime_item.get("provider")
    url = anime_item.get("url", "")
    if provider == "nontonanime" or "nontonanime.co" in url:
        return get_nontonanime_episodes(url)
    return get_otakudesu_episodes(url)

def extract_otakudesu_candidates(ep_url):
    """Extract stream candidate sources for Otakudesu."""
    html_page = curl_get(ep_url)
    candidates = []

    # 1. Direct odcloud / desustream
    iframes = re.findall(r'<iframe[^>]+src="([^"]+)"', html_page)
    for ifr in iframes:
        if "desustream" in ifr or "odcdn" in ifr:
            try:
                ifr_html = curl_get(ifr, referer=ep_url, timeout=4)
                v_urls = re.findall(r'videoURL\s*=\s*["\']([^"\']+)["\']', ifr_html)
                for v in v_urls:
                    candidates.append({
                        "quality": "720p",
                        "server": "ODCloud",
                        "is_hls": False,
                        "resolve_fn": lambda v_url=v: (v_url, None)
                    })
            except Exception:
                pass

    # 2. Download section mirrors (Filedon, Pixeldrain)
    m = re.search(r'<div class="download">(.*?)</div>', html_page, re.DOTALL)
    if m:
        for li in re.findall(r'<li>(.*?)</li>', m.group(1), re.DOTALL):
            q_m = re.search(r'<strong>(.*?)</strong>', li)
            quality = q_m.group(1).strip() if q_m else "720p"
            links = re.findall(r'<a href="([^"]+)"[^>]*>([^<]+)</a>', li)
            for href, host in links:
                host_clean = host.strip()
                if host_clean in ["Filedon"]:
                    candidates.append({
                        "quality": quality,
                        "server": "Filedon",
                        "is_hls": False,
                        "resolve_fn": lambda h=href: resolve_filedon(h)
                    })
                elif host_clean in ["Pdrain", "Pixeldrain", "PDrain"]:
                    candidates.append({
                        "quality": quality,
                        "server": "Pixeldrain",
                        "is_hls": False,
                        "resolve_fn": lambda h=href: resolve_pixeldrain(h)
                    })

    # 3. Mirrorstream section (YourUpload, Filedon, VidHide, etc.)
    actions = re.findall(r'action:"([a-f0-9]{32})"', html_page)
    mirrors = re.findall(r'<a\s+href="#"\s+data-content="([^"]+)">([^<]+)</a>', html_page)
    for b64, name in mirrors:
        try:
            payload = json.loads(base64.b64decode(b64).decode("utf-8"))
            quality = payload.get("q", "720p")
            clean_name = name.strip()
            if any(k in clean_name.lower() for k in ["yourupload", "filedon", "vidhide", "odstream", "ondesuhd"]):
                candidates.append({
                    "quality": quality,
                    "server": f"{clean_name.title()} (Mirror)",
                    "is_hls": False,
                    "resolve_fn": lambda b=b64, n=clean_name: resolve_mirror_stream(ep_url, b, n, actions)
                })
        except Exception:
            pass

    return candidates

def extract_nontonanime_candidates(ep_url):
    """Extract stream candidates for NontonAnime (Putarin HLS streams)."""
    html_page = curl_get(ep_url)
    candidates = []

    iframes = re.findall(r'<iframe[^>]+src=[\"\']([^\"\']+)[\"\']', html_page)
    for ifr in iframes:
        if "putarin" in ifr or "puterin" in ifr:
            domain = urllib.parse.urlparse(ifr).netloc
            candidates.append({
                "quality": "Adaptive HD",
                "server": f"Putarin ({domain})",
                "is_hls": True,
                "resolve_fn": lambda u=ifr: resolve_putarin(u)
            })

    return candidates

def extract_stream_candidates(ep_item):
    """Extract stream candidates based on episode provider."""
    log_info("Mengekstrak opsi mirror Sub Indo...")
    provider = ep_item.get("provider")
    url = ep_item.get("url", "")
    if provider == "nontonanime" or "nontonanime.co" in url:
        return extract_nontonanime_candidates(url)
    return extract_otakudesu_candidates(url)

def play_video(url, title, quality_label="", referer=None, is_hls=False):
    """Play video stream via MPV with optional local HLS proxy."""
    log_success(f"Memutar: {title} ({quality_label})")

    server = None
    stream_to_play = url

    if is_hls:
        try:
            raw_m3u8 = curl_get(url, referer=referer, timeout=10)
            if not raw_m3u8:
                log_warn("Gagal mengunduh daftar putar m3u8.")
                return False
            fixed_bytes = fix_m3u8_content(raw_m3u8, url)

            class LocalM3U8Handler(BaseHTTPRequestHandler):
                def do_GET(self):
                    self.send_response(200)
                    self.send_header("Content-Type", "application/vnd.apple.mpegurl")
                    self.send_header("Content-Length", str(len(fixed_bytes)))
                    self.send_header("Access-Control-Allow-Origin", "*")
                    self.end_headers()
                    self.wfile.write(fixed_bytes)
                def log_message(self, format, *args):
                    pass

            server = HTTPServer(("127.0.0.1", 0), LocalM3U8Handler)
            port = server.server_address[1]
            threading.Thread(target=server.serve_forever, daemon=True).start()
            stream_to_play = f"http://127.0.0.1:{port}/stream.m3u8"
        except Exception as e:
            log_warn(f"Gagal menyiapkan pemutar HLS lokal: {e}")
            return False

    mpv_cmd = [
        "mpv",
        f"--force-media-title=[Sub Indo] {title}",
        f"--user-agent={USER_AGENT}",
        "--resume-playback=yes",
        "--save-position-on-quit=yes",
        "--keep-open=no",
    ]
    if referer:
        mpv_cmd.append(f"--referrer={referer}")

    mpv_cmd.append(stream_to_play)

    try:
        ret = subprocess.run(mpv_cmd)
        return ret.returncode == 0
    except KeyboardInterrupt:
        return True
    finally:
        if server:
            server.shutdown()

def download_video(url, title, quality_label="", referer=None, is_hls=False):
    """Download video stream with yt-dlp or curl."""
    safe_name = re.sub(r'[^A-Za-z0-9._ -]+', '_', f"{title} [{quality_label}].mp4")
    dest_path = Path.cwd() / safe_name
    log_info(f"Mengunduh ke: {dest_path}")

    if is_hls:
        # HLS stream: prefer yt-dlp
        cmd = ["yt-dlp", "--progress", "-o", str(dest_path)]
        if referer:
            cmd.extend(["--referer", referer])
        cmd.extend(["--add-header", f"User-Agent:{USER_AGENT}", url])
        try:
            ret = subprocess.run(cmd)
            if ret.returncode == 0:
                log_success(f"Selesai mengunduh: {dest_path}")
                return
        except FileNotFoundError:
            # Fallback to ffmpeg
            cmd = ["ffmpeg", "-y", "-headers", f"Referer: {referer}\r\nUser-Agent: {USER_AGENT}\r\n", "-i", url, "-c", "copy", str(dest_path)]
            subprocess.run(cmd)
            log_success(f"Selesai mengunduh: {dest_path}")
            return

    # Direct MP4 stream: use curl
    dl_cmd = ["curl", "-L", "-H", f"User-Agent: {USER_AGENT}"]
    if referer:
        dl_cmd.extend(["-H", f"Referer: {referer}"])
    dl_cmd.extend(["-o", str(dest_path), "--progress-bar", url])
    subprocess.run(dl_cmd)
    log_success(f"Selesai mengunduh: {dest_path}")

def save_history(anime_title, anime_url, episode_title, episode_num, episode_url, provider):
    """Save watch history to JSON."""
    history = {}
    if HISTORY_FILE.exists():
        try:
            with open(HISTORY_FILE, "r") as f:
                history = json.load(f)
        except Exception:
            history = {}

    history[anime_url] = {
        "anime_title": anime_title,
        "anime_url": anime_url,
        "last_ep_title": episode_title,
        "last_ep_num": episode_num,
        "last_ep_url": episode_url,
        "provider": provider,
        "timestamp": int(time.time())
    }

    try:
        with open(HISTORY_FILE, "w") as f:
            json.dump(history, f, indent=2)
    except Exception:
        pass

def load_history():
    """Load watch history sorted by recent."""
    if not HISTORY_FILE.exists():
        return []
    try:
        with open(HISTORY_FILE, "r") as f:
            data = json.load(f)
            items = list(data.values())
            items.sort(key=lambda x: x.get("timestamp", 0), reverse=True)
            return items
    except Exception:
        return []

