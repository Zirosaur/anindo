def validate_episodes(episodes):
    if not episodes or not isinstance(episodes, list):
        return False
    valid = 0
    for ep in episodes:
        if ep.get("url") and ep.get("title") and "ep_num" in ep:
            valid += 1
    return valid > 0

def get_anime_details(anime_item):
    log_info("Mengambil daftar episode...")
    provider_name = anime_item.get("provider", "otakudesu")
    provider = REGISTRY.get(provider_name) or REGISTRY.get("otakudesu")
    eps = provider.get_episodes(anime_item["url"])

    # Failover: if episodes empty, try alternate provider
    if not validate_episodes(eps):
        log_warn("Daftar episode tidak ditemukan pada penyedia saat ini. Mencoba failover...")
        raw_title = anime_item.get("raw_title", "")
        if raw_title:
            for alt_name, alt_prov in REGISTRY._providers.items():
                if alt_name == provider_name:
                    continue
                alt_res = alt_prov.search(raw_title)
                if alt_res:
                    log_info(f"Ditemukan alternatif di {alt_prov.display_name}: {alt_res[0]['title']}")
                    anime_item["url"] = alt_res[0]["url"]
                    anime_item["provider"] = alt_name
                    eps = alt_prov.get_episodes(alt_res[0]["url"])
                    if validate_episodes(eps):
                        break
    return eps

