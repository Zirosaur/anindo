    def get_episodes(self, anime_url: str) -> list[dict]:
        html_page = curl_get(anime_url)
        rules = get_rules()
        anchor = rules.get(self.name, {}).get("episode_anchor", "/episode/")

        parser = DOMParser()
        parser.feed(html_page)

        episodes = []
        seen = set()
        for l in parser.links:
            href = l["href"]
            if anchor in href and href not in seen:
                seen.add(href)
                text = l["text"] or l["title"]
                clean_title = text.replace("&#8211;", "-").replace("&amp;", "&").replace("Subtitle Indonesia", "").strip()
                num_m = re.search(r'Episode\s*(\d+(?:\.\d+)?)', clean_title, re.IGNORECASE)
                ep_num = float(num_m.group(1)) if num_m else 0
                episodes.append({
                    "title": clean_title,
                    "url": href,
                    "ep_num": ep_num,
                    "provider": self.name
                })

        episodes.sort(key=lambda x: x["ep_num"] if x["ep_num"] > 0 else 9999)
        return episodes

    def extract_streams(self, ep_url: str) -> list[dict]:
        html_page = curl_get(ep_url)
        candidates = []

        # 1. Direct odcloud / desustream
        iframes = re.findall(r'<iframe[^>]+src="([^"]+)"', html_page)
        for ifr in iframes:
            if "desustream" in ifr or "odcdn" in ifr:
                try:
                    ifr_html = curl_get(ifr, referer=ep_url, timeout=4)
                    v_urls = re.findall(r'videoURL\s*=\s*["\']([^"\']+)["\']', ifr_html)
                    for v in v_urls:
                        candidates.append({
                            "quality": "720p",
                            "server": "ODCloud",
                            "is_hls": False,
                            "resolve_fn": lambda v_url=v: (v_url, None)
                        })
                except Exception:
                    pass

        # 2. Download section mirrors (Filedon, Pixeldrain)
        m = re.search(r'<div class="download">(.*?)</div>', html_page, re.DOTALL)
        if m:
            for li in re.findall(r'<li>(.*?)</li>', m.group(1), re.DOTALL):
                q_m = re.search(r'<strong>(.*?)</strong>', li)
                quality = q_m.group(1).strip() if q_m else "720p"
                links = re.findall(r'<a href="([^"]+)"[^>]*>([^<]+)</a>', li)
                for href, host in links:
                    host_clean = host.strip()
                    if host_clean in ["Filedon"]:
                        candidates.append({
                            "quality": quality,
                            "server": "Filedon",
                            "is_hls": False,
                            "resolve_fn": lambda h=href: resolve_filedon(h)
                        })
                    elif host_clean in ["Pdrain", "Pixeldrain", "PDrain"]:
                        candidates.append({
                            "quality": quality,
                            "server": "Pixeldrain",
                            "is_hls": False,
                            "resolve_fn": lambda h=href: resolve_pixeldrain(h)
                        })

        # 3. Mirrorstream section (YourUpload, Filedon, VidHide, etc.)
        actions = re.findall(r'action:"([a-f0-9]{32})"', html_page)
        mirrors = re.findall(r'<a\s+href="#"\s+data-content="([^"]+)">([^<]+)</a>', html_page)
        for b64, name in mirrors:
            try:
                payload = json.loads(base64.b64decode(b64).decode("utf-8"))
                quality = payload.get("q", "720p")
                clean_name = name.strip()
                if any(k in clean_name.lower() for k in ["yourupload", "filedon", "vidhide", "odstream", "ondesuhd"]):
                    candidates.append({
                        "quality": quality,
                        "server": f"{clean_name.title()} (Mirror)",
                        "is_hls": False,
                        "resolve_fn": lambda b=b64, n=clean_name: resolve_mirror_stream(ep_url, b, n, actions)
                    })
            except Exception:
                pass

        return candidates

