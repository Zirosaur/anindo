def get_rules():
    """Retrieve scraping rules with remote OTA update and local cache."""
    global _ACTIVE_RULES
    if _ACTIVE_RULES is not None:
        return _ACTIVE_RULES

    if RULES_CACHE_FILE.exists():
        try:
            mtime = RULES_CACHE_FILE.stat().st_mtime
            if time.time() - mtime < 43200: # 12h cache
                with open(RULES_CACHE_FILE, "r") as f:
                    _ACTIVE_RULES = json.load(f)
                    return _ACTIVE_RULES
        except Exception:
            pass

    try:
        cmd = ["curl", "-s", "--max-time", "3", "-H", f"User-Agent: {USER_AGENT}", REMOTE_RULES_URL]
        data = subprocess.check_output(cmd).decode("utf-8", "ignore")
        rules = json.loads(data)
        if isinstance(rules, dict) and "otakudesu" in rules:
            _ACTIVE_RULES = rules
            try:
                with open(RULES_CACHE_FILE, "w") as f:
                    json.dump(rules, f, indent=2)
            except Exception:
                pass
            return _ACTIVE_RULES
    except Exception:
        pass

    _ACTIVE_RULES = DEFAULT_RULES
    return _ACTIVE_RULES

def probe_and_resolve_domain(url, timeout=3):
    """Probe a domain, follow redirects (301/302), and return effective base domain if 200 OK."""
    cmd = [
        "curl", "-s", "-I", "-L", "-o", "/dev/null",
        "-w", "%{http_code} %{url_effective}",
        "--max-time", str(timeout),
        "-H", f"User-Agent: {USER_AGENT}",
        url
    ]
    try:
        out = subprocess.check_output(cmd).decode("utf-8", "ignore").strip()
        parts = out.split()
        if len(parts) >= 2 and parts[0] == "200":
            effective = parts[1]
            parsed = urllib.parse.urlparse(effective)
            return f"{parsed.scheme}://{parsed.netloc}"
    except Exception:
        pass
    return None

def get_base_url(provider, force_refresh=False):
    """Get active base URL for a provider with dynamic discovery and multi-level fallback."""
    if not force_refresh and provider in _RESOLVED_DOMAINS:
        return _RESOLVED_DOMAINS[provider]

    env_key = f"ANINDO_{provider.upper()}_URL"
    if os.environ.get(env_key):
        domain = os.environ[env_key].rstrip("/")
        _RESOLVED_DOMAINS[provider] = domain
        return domain

    if USER_CONFIG_FILE.exists():
        try:
            with open(USER_CONFIG_FILE, "r") as f:
                u_cfg = json.load(f)
                cfg_val = u_cfg.get(f"{provider}_url") or u_cfg.get(provider)
                if cfg_val:
                    domain = cfg_val.rstrip("/")
                    _RESOLVED_DOMAINS[provider] = domain
                    return domain
        except Exception:
            pass

    cached_domains = {}
    if not force_refresh and DOMAINS_CACHE_FILE.exists():
        try:
            mtime = DOMAINS_CACHE_FILE.stat().st_mtime
            if time.time() - mtime < 43200: # 12h cache
                with open(DOMAINS_CACHE_FILE, "r") as f:
                    cached_domains = json.load(f)
                    if provider in cached_domains and "active" in cached_domains[provider]:
                        active_cand = cached_domains[provider]["active"]
                        resolved = probe_and_resolve_domain(active_cand, timeout=2)
                        if resolved:
                            _RESOLVED_DOMAINS[provider] = resolved
                            return resolved
        except Exception:
            pass

    candidate_list = list(DEFAULT_DOMAINS.get(provider, []))
    try:
        cmd = ["curl", "-s", "--max-time", "3", "-H", f"User-Agent: {USER_AGENT}", REMOTE_DOMAINS_URL]
        remote_data = subprocess.check_output(cmd).decode("utf-8", "ignore")
        remote_json = json.loads(remote_data)
        if provider in remote_json and isinstance(remote_json[provider], list):
            candidate_list = list(dict.fromkeys(remote_json[provider] + candidate_list))
    except Exception:
        pass

    working_domain = None
    for cand in candidate_list:
        resolved = probe_and_resolve_domain(cand, timeout=3)
        if resolved:
            working_domain = resolved
            break

    if not working_domain:
        working_domain = DEFAULT_DOMAINS.get(provider, [""])[0] if DEFAULT_DOMAINS.get(provider) else ""

    _RESOLVED_DOMAINS[provider] = working_domain

    try:
        disk_cached = {}
        if DOMAINS_CACHE_FILE.exists():
            try:
                with open(DOMAINS_CACHE_FILE, "r") as f:
                    disk_cached = json.load(f)
            except Exception:
                disk_cached = {}
        disk_cached[provider] = {
            "active": working_domain,
            "timestamp": int(time.time())
        }
        with open(DOMAINS_CACHE_FILE, "w") as f:
            json.dump(disk_cached, f, indent=2)
    except Exception:
        pass

    return working_domain

