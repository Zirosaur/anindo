def str_display_width(s: str) -> int:
    """Calculate visible display column width of a string (handling ANSI escape codes and wide glyphs)."""
    s_clean = re.sub(r'\x1b\[[0-9;]*m', '', s)
    w = 0
    for ch in s_clean:
        if ch in ('🎬', '📺', '⌨️', '⏸', '▶', '🔊', '⏮', '⏭', '🔄', '📋', '⏹', '⚙️'):
            w += 2
        elif unicodedata.east_asian_width(ch) in ('W', 'F'):
            w += 2
        else:
            w += 1
    return w

def pad_box_line(content: str, width: int = 70) -> str:
    """Pad content inside a styled terminal box border preserving exact alignment."""
    dw = str_display_width(content)
    pad = max(0, width - 4 - dw)
    return f"{C_CYAN}│{C_RESET}  {content}" + " " * pad + f"{C_CYAN}│{C_RESET}"

