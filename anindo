class ProviderRegistry:
    """Registry that manages modular anime providers and provides concurrent multi-provider search."""
    def __init__(self):
        self._providers: dict[str, BaseProvider] = {}

    def register(self, provider: BaseProvider):
        self._providers[provider.name] = provider

    def get(self, name: str) -> BaseProvider | None:
        return self._providers.get(name)

    def all(self) -> list[BaseProvider]:
        return list(self._providers.values())

    def names(self) -> list[str]:
        return list(self._providers.keys())

    def search_all(self, query: str, active_provider: str = "all") -> list[dict]:
        log_info(f"Mencari '{query}'...")
        if active_provider in self._providers:
            return self._providers[active_provider].search(query)

        results = []
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(self._providers)) as executor:
            futures = {executor.submit(p.search, query): p for p in self._providers.values()}
            for f in concurrent.futures.as_completed(futures):
                try:
                    res = f.result()
                    if res:
                        results.extend(res)
                except Exception:
                    pass
        return results

    def find_cross_provider_fallback(self, anime_raw_title: str, ep_num: float, exclude_provider: str) -> tuple[dict | None, list[dict]]:
        """
        Cross-Provider Episode Stream Fallback:
        Searches other providers for the same anime title & episode number if the current provider fails!
        """
        log_warn(f"Mencari cadangan lintas penyedia (Cross-Provider Fallback)...")
        for p_name, provider in self._providers.items():
            if p_name == exclude_provider:
                continue
            try:
                matches = provider.search(anime_raw_title)
                if not matches:
                    continue
                # Pick the best match
                alt_anime = matches[0]
                eps = provider.get_episodes(alt_anime["url"])
                matched_ep = next((e for e in eps if e["ep_num"] == ep_num), None)
                if matched_ep:
                    cands = provider.extract_streams(matched_ep["url"])
                    if cands:
                        log_success(f"Menemukan mirror cadangan di {provider.display_name} untuk Episode {ep_num}!")
                        return matched_ep, cands
            except Exception:
                pass
        return None, []

